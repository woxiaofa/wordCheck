<!-- 体验主流程：带读 → 口语抽查 → 现有背词 → 一张报告 -->
<view class="page {{skin}}">

  <view class="card head">
    <view class="t1">{{stepText}}</view>
    <view class="progress mt-s"><view class="progress-inner" style="width:{{progressPct}}%"></view></view>
    <view class="muted sm mt-s">{{tip}}</view>
    <!-- 本页由首页 redirectTo 进来，页面栈只有一页，真机没有返回箭头。
         练习中途必须给一个非阻断出口，否则孩子只能走完全程或杀掉小程序。 -->
    <view wx:if="{{stage !== 'report'}}" class="link center mt-s" bindtap="onHome">先不练了，回首页</view>
  </view>

  <!-- ① 带读：词 → 短句 → 小段，出现即主动发音，按住跟读；合格自动进下一条 -->
  <block wx:if="{{stage === 'lead' && item}}">
    <view class="card lesson">
      <view class="muted center">{{item.label}}</view>
      <view wx:if="{{item.kind === 'word'}}" class="qword mt-s">{{item.display}}</view>
      <view wx:elif="{{item.kind === 'sentence'}}" class="qstem mt-s">{{item.display}}</view>
      <block wx:else>
        <view wx:for="{{item.lines}}" wx:for-item="line" wx:key="*this" class="qstem mt-s">{{line}}</view>
      </block>
      <view wx:if="{{item.phonetic}}" class="qph">{{item.phonetic}}</view>
      <view class="muted mt-s">{{item.cn}}</view>
      <view class="link mt-s" bindtap="onReplayDemo">▶ 再听一遍</view>
    </view>

    <view class="card">
      <!-- catch 系列：按住时既不许冒泡，也不许页面滚动把手势抢走（真机「一按就闪」的根因之一）。
           抬手后换成纯展示的 loading，缓冲期间不接受新的一次按下。 -->
      <view wx:if="{{settling}}" class="hold-btn wait">在听你读完…</view>
      <view wx:else class="hold-btn {{holding ? 'on' : ''}} {{passed ? 'done' : ''}}"
            catchtouchstart="onHoldStart" catchtouchend="onHoldEnd"
            catchtouchcancel="onHoldEnd" catchtouchmove="onHoldMove">
        {{holding ? '松手就好' : (passed ? '这一条读过了' : '按住跟读')}}
      </view>

      <view wx:if="{{feedback}}" class="fb fb-{{feedback.grade}} mt">
        <view class="fb-title">{{feedback.verdict}}</view>
        <view wx:for="{{feedback.issues}}" wx:for-item="iss" wx:key="*this" class="muted sm">{{iss}}</view>
      </view>

      <!-- 合格自动进下一条（最后一条读完自动进抽查），所以这里只在「没读对」时给出口。
           按钮再往下放一点，别贴着手，免得刚松手就误触；不写任何关于判定的备注文案。 -->
      <view wx:if="{{canNext}}" class="next-block">
        <button class="btn warn" bindtap="onSkipItem">下一个</button>
      </view>

      <view class="honest mt-s">{{honestTip}}</view>
      <view class="honest">按住跟读只在本机听、不落盘、不上传</view>
    </view>

    <!-- 与 drill 答对同款的 ✓ 庆祝层：闪一下自己收起（CELEBRATE_MS），
         收完正好接上 1 秒后的自动进条（最后一条则自动进抽查） -->
    <view wx:if="{{celebrate}}" class="celebrate">
      <view class="celebrate-pop">✓</view>
      <view class="celebrate-text">读得好！</view>
    </view>
  </block>

  <!-- ② 口语抽查：不给示范音，只考「自己读出来」；书面选择题全在现有 drill 里 -->
  <block wx:if="{{stage === 'check' && q}}">
    <view class="card lesson">
      <view class="muted center">{{q.label}} · 抽查</view>
      <view wx:if="{{q.kind === 'word'}}" class="qword mt-s">{{q.display}}</view>
      <block wx:elif="{{q.lines.length}}">
        <view wx:for="{{q.lines}}" wx:for-item="line" wx:key="*this" class="qstem mt-s">{{line}}</view>
      </block>
      <view wx:else class="qstem mt-s">{{q.display}}</view>
      <view class="muted mt-s">{{q.cn}}</view>

      <view wx:if="{{qSettling}}" class="hold-btn wait mt">在听你读完…</view>
      <view wx:else class="hold-btn {{qHolding ? 'on' : ''}} {{qPassed ? 'done' : ''}} mt"
            catchtouchstart="onQHoldStart" catchtouchend="onQHoldEnd"
            catchtouchcancel="onQHoldEnd" catchtouchmove="onQHoldMove">
        {{qHolding ? '松手就好' : (qPassed ? '这一条读过了' : '按住读出声')}}
      </view>

      <view wx:if="{{qFeedback}}" class="fb fb-{{qFeedback.grade}} mt">
        <view class="fb-title">{{qFeedback.verdict}}</view>
        <view wx:for="{{qFeedback.issues}}" wx:for-item="iss" wx:key="*this" class="muted sm">{{iss}}</view>
      </view>

      <button wx:if="{{qPassed}}" class="btn ok mt" bindtap="onQNext">
        {{qIdx + 1 >= qTotal ? '这轮抽查完' : '下一题'}}
      </button>
      <view class="honest mt-s">{{honestTip}}</view>
      <view class="honest">按住跟读只在本机听、不落盘、不上传</view>
    </view>

    <view wx:if="{{qCelebrate}}" class="celebrate">
      <view class="celebrate-pop">✓</view>
      <view class="celebrate-text">读得好！</view>
    </view>
  </block>

  <!-- ③ 背词：现有 drill 是另一个分包，加载期间给一屏过渡，别留白屏 -->
  <block wx:if="{{stage === 'drill'}}">
    <view class="card lesson">
      <view class="t1">口语和抽查完成</view>
      <view class="muted sm mt-s">接着是认 → 写 → 巩固，最后口语和书面一起出报告</view>
    </view>
  </block>

  <!-- ④ 报告：口语与书面并到一张纸，待练清单可反复练到全流畅 -->
  <block wx:if="{{stage === 'report' && report}}">
    <view class="card">
      <view class="t1">这一轮的报告</view>
      <view class="stat-row">
        <view class="stat">
          <view class="stat-n">{{report.oral.total}}</view>
          <view class="muted sm">跟读条数</view>
        </view>
        <view class="stat">
          <view class="stat-n">{{report.oral.perfect}}</view>
          <view class="muted sm">读得流畅</view>
        </view>
        <view class="stat">
          <view class="stat-n">{{report.check.wrong}}</view>
          <view class="muted sm">抽查没过</view>
        </view>
      </view>
      <view class="muted sm mt-s">
        书面背词：<text wx:if="{{report.drill}}">{{report.drill.mastered}} / {{report.drill.total}} 个词拿下，用时 {{report.drill.elapsedText}}</text><text wx:else>这轮没走完背词</text>
      </view>
      <view wx:if="{{report.oral.forced}}" class="muted sm">有 {{report.oral.forced}} 条读了几次还不太顺，已经列在下面</view>
      <view wx:if="{{report.allPerfect}}" class="fb fb-ok mt-s">全读流畅、也都对了</view>
    </view>

    <view wx:if="{{report.practice.length}}" class="card">
      <view class="t1">还想再练的</view>
      <view wx:for="{{report.practice}}" wx:for-item="p" wx:key="refText" class="practice-row">
        <view class="practice-text">{{p.refText}}</view>
        <view class="muted sm">{{p.reason}}</view>
      </view>
    </view>

    <view class="card">
      <button wx:if="{{report.practice.length}}" class="btn" bindtap="onPractice">只练没读流畅的</button>
      <button class="btn ghost mt-s" bindtap="onRestartAll">整轮重新来一次</button>
      <button class="btn ghost mt-s" bindtap="onHome">回首页</button>
    </view>
  </block>

  <view class="card mt">
    <button class="btn ghost sm" open-type="contact">遇到问题？给开发者留言</button>
  </view>
</view>
