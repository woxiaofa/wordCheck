/**
 * 主题 token 表（1.2.0）
 *
 * 命名规则：按「用途 + 深浅」分层，不是按色号。
 *   bg      页面底色      bg2       页面底色（略微抬高的那一层，如列表整块背景）
 *   surface 卡片          surface2  卡片里的嵌套块   surface3 按键/键盘面
 *   fill    输入框、行底   fill2/3   同类块的其他深浅
 *   line    描边主线       line2~6   次级分割线（按由深到浅）
 *   text    主文字         text2/3   次级文字
 *   muted   弱化文字       muted2~5  逐级减弱的说明文字
 *   accent  强调色/链接    active    按下的瞬时态
 *
 * 取值说明：skin-night 的每个值都与改造前各页面硬编码的颜色**逐一对齐**，
 * 所以这次变量化在视觉上是零变化的；换肤时只重写这些变量。
 *
 * 功能色不在此列（对错必须有固定语义）：ok #2fd07a / bad #ff5c72 /
 * warn #ffb020 / gold #ffd166 / purple #7c5cff，仍直接写在业务样式里。
 */

page {
  --bg: #0f1620;
  --bg2: #101a24;
  --surface: #18222e;
  --surface2: #1e2a38;
  --surface3: #243040;
  --fill: #16202c;
  --fill2: #16222f;
  --fill3: #141d28;
  --line: #2b3949;
  --line2: #223044;
  --line3: #22303f;
  --line4: #26313f;
  --line5: #2c4157;
  --line6: #223042;
  --text: #e8eef5;
  --text2: #e8f0f8;
  --text3: #cfe0f0;
  --muted: #8fa3b7;
  --muted2: #8b9bad;
  --muted3: #8fa8c0;
  --muted4: #7f93a8;
  --muted5: #6b7a8c;
  --accent: #3ea6ff;
  --active: #3a4a5e;
}

/* 皮肤：挂在页面根节点上，向下继承。
   新增皮肤只需在这里写差异 token，未列出的键自动沿用 page 里的夜色值。 */
.skin-night {
  --bg: #0f1620;
  --bg2: #101a24;
  --surface: #18222e;
  --surface2: #1e2a38;
  --surface3: #243040;
  --fill: #16202c;
  --fill2: #16222f;
  --fill3: #141d28;
  --line: #2b3949;
  --line2: #223044;
  --line3: #22303f;
  --line4: #26313f;
  --line5: #2c4157;
  --line6: #223042;
  --text: #e8eef5;
  --text2: #e8f0f8;
  --text3: #cfe0f0;
  --muted: #8fa3b7;
  --muted2: #8b9bad;
  --muted3: #8fa8c0;
  --muted4: #7f93a8;
  --muted5: #6b7a8c;
  --accent: #3ea6ff;
  --active: #3a4a5e;
}
