  --muted: #8fa3b7;
  --muted2: #8b9bad;
  --muted3: #8fa8c0;
  --muted4: #7f93a8;
  --muted5: #6b7a8c;
  --accent: #3ea6ff;
  --active: #3a4a5e;
  --press: #24344a;
  --ok-text: #2fd07a;
  --warn-text: #ffb020;
  --bad-text: #ff5c72;
  --ok-dim: #a9c8b6;
  --gold-dim: #bd7d08;
  --ok-bg: #173626;
  --ok-soft: #7fd6a0;
  --ok-line: #24563a;
  --bad-bg: #3a1f2a;
  --bad-soft: #ffb0b0;
