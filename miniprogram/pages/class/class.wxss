/* 班级页样式：沿用全局暗色卡片体系，只补本页特有的少量类 */

.center { text-align: center; }
.mt { margin-top: 24rpx; }
.mt-s { margin-top: 14rpx; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.grow { flex: 1; }

/* 排查用：把原始报错和云自检结果摊在页面上（等宽小字，可长按复制） */
.raw-err {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  background: #101a24;
  border: 2rpx solid #24313f;
  border-radius: 12rpx;
  color: #ffb4bf;
  font-size: 22rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 邀请码徽章 */
.code-badge {
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  background: #16222f;
  border: 2rpx dashed #3ea6ff;
  text-align: center;
}
.code {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #3ea6ff;
  margin-top: 4rpx;
}

/* 分隔线（未加入态的两个入口之间） */
.divider {
  display: flex;
  align-items: center;
  margin: 26rpx 0;
  color: #8fa3b7;
  font-size: 24rpx;
}
.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: #1e2a38;
}
.divider text { padding: 0 20rpx; }

/* 表单 */
.form-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 22rpx;
}
.form-label {
  width: 84rpx;
  font-size: 26rpx;
  color: #8fa3b7;
  flex-shrink: 0;
}
/* 续接上次布置（起点一键顺延） */
.continue-row { justify-content: space-between; gap: 12rpx; margin-top: 14rpx; }
.continue-btn {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #7fc0ff;
  background: rgba(62, 166, 255, .12);
  border: 1rpx solid rgba(62, 166, 255, .4);
}
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #1e2a38;
  color: #8fa3b7;
  font-size: 26rpx;
}
.chip.on {
  background: rgba(62, 166, 255, .18);
  color: #3ea6ff;
  border: 2rpx solid #3ea6ff;
}
.input {
  background: #1e2a38;
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
  color: #e8eef5;
}
.picker-val {
  background: #1e2a38;
  border-radius: 14rpx;
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  color: #e8eef5;
}

/* 作业条目 */
.assign {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid #1e2a38;
}
.assign-name { font-size: 28rpx; font-weight: 600; }
.bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: #1e2a38;
  margin-top: 12rpx;
  overflow: hidden;
}
.bar-in {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2fd07a, #3ea6ff);
  transition: width .3s;
}
.bad-text { color: #ff5c72; font-size: 24rpx; }
/* 逐学员名单的名字配色：done 绿 / review 黄（词学过但有忘词）/ pending 红 */
.ok-text { color: #7fd6a0; font-size: 24rpx; }
.warn-text { color: #ffd88a; font-size: 24rpx; }

/* 学员行 */
.stu {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid #1e2a38;
}
.stu-main { display: flex; align-items: center; gap: 18rpx; flex: 1; min-width: 0; }
.stu-ava {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2b7fb8, #7c5cff);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.stu-mid { flex: 1; font-size: 28rpx; }

/* 名字行 + 展开箭头（2026-10-10：代替"（点看报告）"——那条小字会折行成"点看报/告"） */
.stu-name-row { display: flex; align-items: center; gap: 8rpx; }
.stu-name { font-weight: 600; }
.stu-arrow {
  color: #8fa8c0;
  font-size: 24rpx;
  transition: transform .2s ease;
  transform-origin: center;
  display: inline-block;
}
.stu-arrow.open { transform: rotate(90deg); }

/* 状态一行：图标 + 简短数据，五档配色（灰待同步/红失联/黄有忘词/绿不错） */
.stu-status { font-size: 22rpx; margin-top: 4rpx; }
.stu-status.t-gray { color: #8fa8c0; }
.stu-status.t-red { color: #ff8a8a; }
.stu-status.t-amber { color: #ffd88a; }
.stu-status.t-green { color: #7fd6a0; }

/* 学员进度报告（展开区） */
.report {
  margin-top: 14rpx;
  margin-left: 90rpx;
  padding: 20rpx 24rpx;
  background: #16222f;
  border-radius: 16rpx;
  border: 2rpx solid #1e2a38;
}
.report-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #3ea6ff;
  margin-bottom: 10rpx;
}
.report-assign { margin-top: 14rpx; }
.report-logs { margin-top: 20rpx; }
.report-log {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 8rpx 0;
  font-size: 26rpx;
}
.log-mark { width: 36rpx; text-align: center; font-weight: 700; flex-shrink: 0; }
.log-mark.ok { color: #2fd07a; }
.log-mark.bad { color: #ff5c72; }
.log-word { font-weight: 600; }
.log-trans {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 22rpx;
}
.log-time { font-size: 20rpx; opacity: .7; flex-shrink: 0; }

/* 个性化作业逐学员明细：教练端作业卡内展开 */
.per-stu {
  margin-top: 12rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid #2a3a52;
}
.per-stu-row { padding: 6rpx 0; }
.per-stu-name { font-size: 26rpx; font-weight: 600; margin-right: 12rpx; }
.per-stu-mid { font-size: 22rpx; margin-right: 12rpx; }
.per-stu-words { font-size: 0; }

/* 学习简报（教练端学员报告内，与学员端同一句文案） */
.summary { margin-bottom: 18rpx; }
.summary-text { font-size: 26rpx; line-height: 1.7; }
.honor {
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: linear-gradient(90deg, #3a2f10, #2a2a1c);
  border: 2rpx solid #7a6320;
}
.honor-badge { font-size: 30rpx; font-weight: 700; color: #ffd166; }
.honor-detail { font-size: 22rpx; color: #c9b98a; margin-top: 6rpx; }
.loop-tip { margin-top: 10rpx; font-size: 22rpx; color: #ffb0b0; }

/* 布置作业的"量"提示：超过建议值时变黄，仍可继续布置（只是提醒，不拦） */
.count-tip {
  margin: 8rpx 0 4rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #16202c;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8fa3b7;
}
.count-tip.warn {
  background: #2e2416;
  color: #ffb020;
  border: 1rpx solid #5a4520;
}

/* 老师端"一张表"：谁没交 / 错哪几个词 / 错在哪
   设计取舍：这里不用图表。老师要的是 5 秒内点出三个名字和三五个词，
   图表要读图例、坐标，反而更慢。 */
.pending-line {
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #16202c;
  display: flex;
  align-items: flex-start;
}
.pending-line.done { background: #14261c; }
/* 忘词待巩固：词学过了但有抽查答忘的 —— 黄色调，提醒而不是催 */
.pending-line.warn { background: #241f14; }
.pending-tag.warn-tag { color: #ffd88a; background: #3a3117; }
.pending-tag {
  flex-shrink: 0;
  margin-right: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #ffb0b0;
  background: #3a1f24;
}
.pending-tag.ok { color: #7fd6a0; background: #173626; }
.pending-names { flex: 1; font-size: 24rpx; color: #cfe0f0; line-height: 1.6; }

.wrong-box {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #141d28;
  border: 1rpx solid #223044;
}
.wrong-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 8rpx;
}
.wrong-line .muted { flex-shrink: 0; margin-right: 12rpx; font-size: 22rpx; color: #6b8095; }
.wt-chip {
  /* view + flex 定高：不再依赖 text 行盒（text 套 text 曾把行盒撑到两倍高） */
  display: flex;
  align-items: center;
  height: 44rpx;
  margin: 4rpx 8rpx 4rpx 0;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: #cfe0f0;
  background: #22303f;
  line-height: 1;
  max-width: 100%;
  overflow: hidden;
}
.wt-chip .wt-word { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-shrink: 1; }
.wt-trans { margin-left: 8rpx; font-size: 20rpx; color: #7f93a8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-shrink: 1; }
.wt-cnt { margin-left: 8rpx; font-size: 20rpx; color: #ffb020; flex-shrink: 0; }
.wt-chip.alt { background: #2b2438; color: #cdbcff; }
.wt-chip.danger { background: #3a2028; color: #ffb0b0; }
.wrong-box .why { margin-top: 10rpx; font-size: 20rpx; opacity: .7; }
.per-stu-row.head { border-bottom: 1rpx solid #223044; padding-bottom: 8rpx; }
.per-stu-row.head .muted { font-size: 20rpx; }

/* ===== 布置预览 + 编辑（2026-10-09）===== */
.preview-box {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #16222f;
  border: 1rpx solid #24374a;
  border-radius: 12rpx;
}
.preview-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  font-weight: 600;
}
.preview-edited { font-size: 22rpx; color: #e8a33d; font-weight: 400; }
.preview-chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.preview-chip {
  background: #1e2a38;
  border: 1rpx solid #2c4157;
  color: #dce8f4;
  border-radius: 24rpx;
  padding: 6rpx 20rpx;
  font-size: 24rpx;
}
.chip-x { color: #c0392b; margin-left: 6rpx; }
.preview-empty { font-size: 24rpx; color: #c0392b; }
.preview-search {
  margin-top: 14rpx;
  background: #1e2a38;
  border: 1rpx solid #2c4157;
  color: #dce8f4;
  border-radius: 10rpx;
  padding: 10rpx 20rpx;
  font-size: 26rpx;
}
.search-hits {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}
.search-hit {
  background: rgba(62, 166, 255, .18);
  color: #7cc4ff;
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
  font-size: 24rpx;
}
.preview-note { margin-top: 12rpx; font-size: 20rpx; color: #8a97a5; }
