<!-- 班级页：一页三态——未加入（二选一入口）/ 教练端 / 学生端。
     数据全部来自 class 云函数；云不可用时整页降级为提示，本地功能不受影响。 -->
<view class="page">

  <!-- ===== 加载中 ===== -->
  <view wx:if="{{loading}}" class="card center muted">正在载入班级…</view>

  <!-- ===== 云不可用 ===== -->
  <view wx:elif="{{cloudError}}" class="card">
    <view class="t1">班级功能需要联网</view>
    <view class="muted mt-s">{{cloudError}}</view>
    <view wx:if="{{cloudRaw}}" class="raw-err">{{cloudRaw}}</view>
    <button class="btn mt" bindtap="reload">重试</button>
    <button class="btn ghost mt-s" bindtap="runDiagnose">云自检</button>
    <view wx:if="{{diagnoseText}}" class="raw-err">{{diagnoseText}}</view>
  </view>

  <!-- ===== 未加入任何班级 ===== -->
  <view wx:elif="{{!my.role}}" class="card">
    <view class="t1">家长 / 老师布置任务</view>
    <view class="muted mt-s">
      创建班级后把邀请码告诉孩子，孩子在这里输入即可加入。
      你可以布置单词任务、查看掌握进度、生成催学提醒。
    </view>
    <button class="btn ok mt" bindtap="startCreate">我是家长 / 老师，建班级</button>
    <view class="divider"><text>或者</text></view>
    <button class="btn ghost" bindtap="startJoin">我有邀请码，加入班级</button>
  </view>

  <!-- ===== 教练端 ===== -->
  <block wx:elif="{{my.role === 'coach'}}">

    <!-- 班级卡：名字 + 邀请码（复制给孩子） -->
    <view class="card">
      <view class="row-between">
        <view>
          <view class="muted" style="font-size:24rpx">我的班级</view>
          <view class="t1">{{cls.name}}</view>
        </view>
        <view class="code-badge" bindtap="copyCode">
          <view class="muted" style="font-size:22rpx">邀请码（点我复制）</view>
          <view class="code">{{cls.code}}</view>
        </view>
      </view>
      <view class="muted mt-s" style="font-size:24rpx">
        把邀请码发给孩子 → 孩子打开本页选「加入班级」输入即可
      </view>
    </view>

    <!-- 布置任务 -->
    <view class="card">
      <view class="card-title">布置任务</view>
      <view class="form-row">
        <text class="form-label">词库</text>
        <view class="chips">
          <view
            wx:for="{{tags}}"
            wx:key="key"
            class="chip {{form.tag === item ? 'on' : ''}}"
            data-tag="{{item}}"
            bindtap="pickTag"
          >{{item}}</view>
        </view>
      </view>
      <view class="form-row">
        <text class="form-label">词数</text>
        <slider min="3" max="30" step="1" value="{{form.count}}" activeColor="#3ea6ff"
                block-size="20" show-value bindchange="pickCount" class="grow" />
      </view>
      <view class="form-row">
        <text class="form-label">截止</text>
        <picker mode="date" value="{{form.deadline}}" start="{{today}}" bindchange="pickDeadline">
          <view class="picker-val">{{form.deadline || '不限（可选）'}}</view>
        </picker>
        <text wx:if="{{form.deadline}}" class="link" bindtap="clearDeadline">清除</text>
      </view>
      <view class="form-row">
        <text class="form-label">备注</text>
        <input class="grow input" value="{{form.note}}" placeholder="作业名称，不填自动按日期命名"
               maxlength="30" bindinput="inputNote" />
      </view>
      <view class="form-row">
        <view class="grow">
          <text class="form-label">按孩子程度个性化</text>
          <view class="muted" style="font-size:22rpx">易错词优先、已掌握的词跳过；每人词单不同</view>
        </view>
        <switch checked="{{form.personalized}}" bindchange="togglePersonal" color="#7c5cff" />
      </view>
      <button class="btn ok mt" loading="{{assigning}}" disabled="{{assigning}}" bindtap="submitAssign">
        布置 {{form.count}} 个词{{form.tag === '全部' ? '' : '（' + form.tag + '）'}}{{form.personalized ? ' · 个性化' : ''}}
      </button>
    </view>

    <!-- 已布置的作业 -->
    <view class="card" wx:if="{{assignError || assignments.length}}">
      <view class="card-title">已布置（{{assignments.length}}）</view>
      <view wx:if="{{assignError}}" class="muted mt-s">
        加载失败：{{assignError}}
        <text class="link" bindtap="reload"> 重试</text>
      </view>
      <view class="assign" wx:for="{{assignments}}" wx:key="id">
        <view class="row-between">
          <text class="assign-name">{{item.name || item.note || item.tag + '作业'}}</text>
          <text class="muted" style="font-size:24rpx">{{item.finished}}/{{item.total_students}} 人完成</text>
        </view>
        <view class="muted" style="font-size:24rpx">
          {{item.tag}} · {{item.count}} 词{{item.deadline ? ' · ' + item.deadline + ' 截止' : ''}}{{item.personalized ? ' · 个性化' : ''}}
        </view>
        <view class="bar"><view class="bar-in" style="width:{{item.total_students ? item.finished * 100 / item.total_students : 0}}%"></view></view>
        <!-- 个性化透明化：每个孩子分到什么词、各自进度，一页看全（否则家长无从确认词单真的不同） -->
        <view wx:if="{{item.per_student.length}}" class="per-stu">
          <view class="per-stu-row" wx:for="{{item.per_student}}" wx:for-item="ps" wx:key="user_id">
            <text class="per-stu-name">{{ps.nickname}}</text>
            <text class="muted per-stu-mid">{{ps.done}}/{{ps.count}}{{ps.forgot ? ' · 忘 ' + ps.forgot : ''}}</text>
            <view class="per-stu-words">
              <text class="muted" style="font-size:22rpx">{{ps.wrong_top ? '错词 ' + ps.wrong_top + ' · ' : ''}}{{ps.skipped_mastered ? '跳过已掌握 ' + ps.skipped_mastered + ' · ' : ''}}{{ps.preview}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 学员 -->
    <view class="card">
      <view class="card-title">学员（{{students.length}}）</view>
      <view wx:if="{{stuError}}" class="muted mt-s">
        加载失败：{{stuError}}
        <text class="link" bindtap="reload"> 重试</text>
      </view>
      <view wx:if="{{!students.length && !stuError}}" class="muted mt-s">
        还没有学员加入。把上面的邀请码发给孩子，等孩子输入后就出现在这里。
      </view>
      <view class="stu" wx:for="{{students}}" wx:key="id">
        <view class="stu-main" data-id="{{item.id}}" bindtap="toggleReport">
          <view class="stu-ava">{{item.nickname[0] || '学'}}</view>
          <view class="stu-mid">
            <view>{{item.nickname}}<text class="muted" style="font-size:20rpx">（点看报告）</text></view>
            <!-- 家长真正想看的是"今天学没学、学得怎么样"，累计词数只是补充 -->
            <view wx:if="{{item.synced}}" class="muted" style="font-size:22rpx">
              今天 {{item.today.count}} 个<text wx:if="{{item.today.count}}"> · 掌握 {{item.todayRate}}%</text>
              <text wx:if="{{item.wrong}}"> · 易错 {{item.wrong}} 词</text>
            </view>
            <view wx:else class="muted" style="font-size:22rpx">
              还没同步数据（孩子打开小程序学过之后才会出现）
            </view>
            <view class="muted" style="font-size:22rpx;opacity:.75">
              累计 {{item.stats.learned_words || 0}} 词 · {{item.lastSeenText}}
            </view>
          </view>
        </view>
        <button class="btn sm ghost" data-id="{{item.id}}" catchtap="makeNudge">催一催</button>
      </view>

      <!-- 学员进度报告（点学员卡展开） -->
      <block wx:for="{{students}}" wx:for-item="stu" wx:key="id">
        <view wx:if="{{reports[stu.id] && reports[stu.id].open}}" class="report">
          <view class="report-title">{{stu.nickname}} 的进度报告</view>
          <view wx:if="{{reports[stu.id].loading}}" class="muted mt-s">加载中…</view>
          <view wx:elif="{{reports[stu.id].error}}" class="muted mt-s">
            加载失败：{{reports[stu.id].error}}
            <text class="link" data-id="{{stu.id}}" bindtap="toggleReport"> 重试</text>
          </view>
          <block wx:else>
            <view wx:if="{{!reports[stu.id].assignments.length && !reports[stu.id].logs.length}}"
                  class="muted mt-s">还没有学习记录，等孩子学一轮后再来看。</view>
            <view wx:for="{{reports[stu.id].assignments}}" wx:key="id" class="report-assign">
              <view class="row-between">
                <text class="assign-name">{{item.name || item.note || item.tag + '作业'}}</text>
                <text class="muted" style="font-size:22rpx">{{item.done}}/{{item.count}}</text>
              </view>
              <view class="bar"><view class="bar-in" style="width:{{item.count ? item.done * 100 / item.count : 0}}%"></view></view>
            </view>
            <view wx:if="{{reports[stu.id].logs.length}}" class="report-logs">
              <view class="muted" style="font-size:22rpx;margin-bottom:8rpx">最近评分</view>
              <view class="report-log" wx:for="{{reports[stu.id].logs}}" wx:key="index">
                <text class="log-mark {{item.ok ? 'ok' : 'bad'}}">{{item.ok ? '✓' : '✗'}}</text>
                <text class="log-word">{{item.word_text}}</text>
                <text class="muted log-trans">{{item.translation}}</text>
                <text class="muted log-time">{{item.timeText}}</text>
              </view>
            </view>
          </block>
        </view>
      </block>
    </view>

    <!-- 数据对不上时的自证入口：平时低调，需要时一页看全云端事实 -->
    <view class="card">
      <button class="btn ghost sm" bindtap="runDiagnose">云自检 · 数据对不上时点我</button>
      <button class="btn ghost sm mt-s" bindtap="runRepair">修复历史数据 · 学习记录找回</button>
      <view wx:if="{{diagnoseText}}" class="raw-err mt-s">{{diagnoseText}}</view>
    </view>
  </block>

  <!-- ===== 学生端 ===== -->
  <block wx:elif="{{my.role === 'student'}}">
    <view class="card">
      <view class="muted" style="font-size:24rpx">我加入的班级</view>
      <view class="t1">{{cls.name}}</view>
      <!-- 显示邀请码：和教练端的码一比对，立刻能发现"加了同名班"这种张冠李戴 -->
      <view class="muted" style="font-size:24rpx">邀请码 {{cls.code}}</view>
    </view>

    <view class="card" wx:if="{{myAssignError || myAssignments.length}}">
      <view class="card-title">老师 / 家长布置的任务</view>
      <view wx:if="{{myAssignError}}" class="muted mt-s">
        加载失败：{{myAssignError}}
        <text class="link" bindtap="reload"> 重试</text>
      </view>
      <view class="assign" wx:for="{{myAssignments}}" wx:key="id">
        <view class="row-between">
          <text class="assign-name">{{item.name || item.note || item.tag + '作业'}}</text>
          <text class="{{item.expired ? 'bad-text' : 'muted'}}" style="font-size:24rpx">
            {{item.expired ? '已过期 · ' : ''}}{{item.done}}/{{item.count}}
          </text>
        </view>
        <view class="bar"><view class="bar-in" style="width:{{item.count ? item.done * 100 / item.count : 0}}%"></view></view>
        <button class="btn sm mt-s {{item.done >= item.count ? 'ghost' : 'ok'}}"
                data-idx="{{index}}" bindtap="goStudyAssignment">
          {{item.done >= item.count ? '已完成，再去巩固' : '去做这份作业'}}
        </button>
      </view>
    </view>
    <view class="card" wx:else>
      <view wx:if="{{emptyHint === 'TEACHER_HAS_OTHER_CLASS'}}" class="muted" style="line-height:1.8">
        老师确实布置过作业，但不在你加入的这个班里——多半是班级重名，加错了班。
        <text class="link" bindtap="leaveConfirm">退出班级</text> 后用老师最新发的邀请码重新加入即可。
      </view>
      <view wx:else class="muted center">班里还没有布置任务，先按今日任务学习吧。</view>
    </view>

    <view class="card">
      <button class="btn ghost sm" bindtap="leaveConfirm">退出班级（换班用）</button>
      <button class="btn ghost sm mt-s" bindtap="runDiagnose">云自检 · 作业进度对不上时点我</button>
      <button class="btn ghost sm mt-s" bindtap="runRepair">修复历史数据 · 学习记录找回</button>
      <view wx:if="{{diagnoseText}}" class="raw-err mt-s">{{diagnoseText}}</view>
    </view>
  </block>

  <footer-nav active="class" />
</view>
