<!-- 班级页：一页三态——未加入（二选一入口）/ 教练端 / 学生端。
     数据全部来自 class 云函数；云不可用时整页降级为提示，本地功能不受影响。 -->
<view class="page {{layoutWide ? 'wide' : ''}}" style="{{layoutStyle}}">

  <!-- ===== 加载中 ===== -->
  <view wx:if="{{loading}}" class="card center muted">正在载入班级…</view>

  <!-- ===== 云不可用 ===== -->
  <view wx:elif="{{cloudError}}" class="card">
    <view class="t1">班级功能需要联网</view>
    <view class="muted mt-s">{{cloudError}}</view>
    <view wx:if="{{cloudRaw}}" class="raw-err">{{cloudRaw}}</view>
    <button class="btn mt" bindtap="reload">重试</button>
    <button class="btn ghost mt-s" bindtap="runDiagnose">云自检</button>
    <view wx:if="{{diagnoseText}}" class="raw-err">{{diagnoseText}}</view>
  </view>

  <!-- ===== 未加入任何班级 ===== -->
  <view wx:elif="{{!my.role}}" class="card">
    <view class="t1">家长 / 老师布置任务</view>
    <view class="muted mt-s">
      创建班级后把邀请码告诉孩子，孩子在这里输入即可加入。
      你可以布置单词任务、查看掌握进度、生成催学提醒。
    </view>
    <button class="btn ok mt" bindtap="startCreate">我是家长 / 老师，建班级</button>
    <view class="divider"><text>或者</text></view>
    <button class="btn ghost" bindtap="startJoin">我有邀请码，加入班级</button>
  </view>

  <!-- ===== 教练端 ===== -->
  <block wx:elif="{{my.role === 'coach'}}">

    <!-- 班级卡：名字 + 邀请码（复制给孩子） -->
    <view class="card">
      <view class="row-between">
        <view>
          <view class="muted" style="font-size:24rpx">我的班级</view>
          <view class="t1">{{cls.name}}</view>
        </view>
        <view class="code-badge" bindtap="copyCode">
          <view class="muted" style="font-size:22rpx">邀请码（点我复制）</view>
          <view class="code">{{cls.code}}</view>
        </view>
      </view>
      <view class="muted mt-s" style="font-size:24rpx">
        把邀请码发给孩子 → 孩子打开本页选「加入班级」输入即可
      </view>
    </view>

    <!-- 布置任务 -->
    <view class="card">
      <view class="card-title">布置任务</view>
      <view class="form-row">
        <text class="form-label">范围</text>
        <view class="chips">
          <view class="chip {{form.scope === 'tag' ? 'on' : ''}}" data-scope="tag" bindtap="pickScope">按词库</view>
          <view class="chip {{form.scope === 'unit' ? 'on' : ''}}" data-scope="unit" bindtap="pickScope">按教材单元</view>
        </view>
      </view>
      <!-- 按词库：老方式，行为保持不变 -->
      <view class="form-row" wx:if="{{form.scope === 'tag'}}">
        <text class="form-label">词库</text>
        <view class="chips">
          <view
            wx:for="{{tags}}"
            wx:key="key"
            class="chip {{form.tag === item ? 'on' : ''}}"
            data-tag="{{item}}"
            bindtap="pickTag"
          >{{item}}</view>
        </view>
      </view>
      <!-- 按教材单元：跟着课本进度布置（"今天讲完 Unit 3，就布置 Unit 3"） -->
      <view class="form-row" wx:else>
        <text class="form-label">单元</text>
        <picker wx:if="{{unitNames.length}}" mode="selector" range="{{unitNames}}"
                value="{{form.unitIndex}}" bindchange="pickUnit">
          <view class="picker-val">{{unitNames[form.unitIndex]}}</view>
        </picker>
        <text wx:else class="muted" style="font-size:24rpx">暂无可用教材</text>
      </view>
      <view wx:if="{{form.scope === 'unit'}}" class="muted" style="font-size:22rpx;margin:-8rpx 0 8rpx">
        按课本顺序出题，学完这一单元刚好跟上课堂进度
      </view>
      <view class="form-row">
        <text class="form-label">词数</text>
        <slider min="3" max="30" step="1" value="{{form.count}}" activeColor="#3ea6ff"
                block-size="20" show-value bindchange="pickCount" class="grow" />
      </view>
      <!-- 小学阶段的量：一次超过 10 个，孩子多半会为了赶完乱点，等于没学 -->
      <view class="count-tip {{form.count > 10 ? 'warn' : ''}}">
        {{form.count > 10
          ? '⚠️ 小学生一次建议不超过 10 个词 —— 词太多容易为了赶进度乱点，看着做完了其实没记住'
          : '小学生一次 5~10 个词效果最好：做完有成就感，也记得住'}}
      </view>

      <!-- 预览词单：布置前就能看到"到底是哪些词"，可删可加（所见即所得） -->
      <view class="preview-box">
        <view class="preview-head">
          <text>本次布置的词（{{preview.length}} 个）</text>
          <text wx:if="{{previewEdited}}" class="preview-edited">已编辑 · 作业名会带"自定义"</text>
        </view>
        <view class="preview-chips">
          <view wx:for="{{preview}}" wx:key="*this" class="preview-chip"
                data-idx="{{index}}" bindtap="removeWord">{{item}} <text class="chip-x">×</text></view>
          <view wx:if="{{!preview.length}}" class="preview-empty">词单空了 —— 在下面搜索单词加回来，至少 3 个</view>
        </view>
        <input class="preview-search" value="{{searchKw}}" placeholder="搜索单词添加，如 apple"
               bindinput="onSearchInput" />
        <view wx:if="{{searchHits.length}}" class="search-hits">
          <view wx:for="{{searchHits}}" wx:key="*this" class="search-hit"
                data-word="{{item}}" bindtap="addWord">+ {{item}}</view>
        </view>
        <view class="preview-note">改动范围或词数会重新生成词单；点词可删、搜索可加。拍照拍单词表自动加词，下个版本再上</view>
      </view>
      <view class="form-row">
        <text class="form-label">截止</text>
        <picker mode="date" value="{{form.deadline}}" start="{{today}}" bindchange="pickDeadline">
          <view class="picker-val">{{form.deadline || '不限（可选）'}}</view>
        </picker>
        <text wx:if="{{form.deadline}}" class="link" bindtap="clearDeadline">清除</text>
      </view>
      <view class="form-row">
        <text class="form-label">备注</text>
        <input class="grow input" value="{{form.note}}" placeholder="作业名称，不填自动按日期命名"
               maxlength="30" bindinput="inputNote" />
      </view>
      <view class="form-row">
        <view class="grow">
          <text class="form-label">按孩子程度个性化</text>
          <view class="muted" style="font-size:22rpx">易错词优先、已掌握的词跳过；每人词单不同</view>
        </view>
        <switch checked="{{form.personalized}}" bindchange="togglePersonal" color="#7c5cff" />
      </view>
      <button class="btn ok mt" loading="{{assigning}}" disabled="{{assigning}}" bindtap="submitAssign">
        {{form.scope === 'unit'
          ? '布置 ' + unitNames[form.unitIndex]
          : '布置 ' + form.count + ' 个词' + (form.tag === '全部' ? '' : '（' + form.tag + '）')}}{{form.personalized ? ' · 个性化' : ''}}
      </button>
    </view>

    <!-- 已布置的作业 -->
    <view class="card" wx:if="{{assignError || assignments.length}}">
      <view class="card-title">已布置（{{assignments.length}}）</view>
      <view wx:if="{{assignError}}" class="muted mt-s">
        加载失败：{{assignError}}
        <text class="link" bindtap="reload"> 重试</text>
      </view>
      <view class="assign" wx:for="{{assignments}}" wx:key="id">
        <view class="row-between">
          <text class="assign-name">{{item.name || item.note || item.tag + '作业'}}</text>
          <text class="muted" style="font-size:24rpx">{{item.finished}}/{{item.total_students}} 人完成</text>
        </view>
        <view class="muted" style="font-size:24rpx">
          {{item.unit_label || item.tag}} · {{item.count}} 词{{item.deadline ? ' · ' + item.deadline + ' 截止' : ''}}{{item.personalized ? ' · 个性化' : ''}}
        </view>
        <view class="bar"><view class="bar-in" style="width:{{item.total_students ? item.finished * 100 / item.total_students : 0}}%"></view></view>

        <!-- 老师布置完想亲自看看词对不对：试做走学生同一条 drill?ids= 路径 -->
        <button class="btn sm ghost mt-s" data-idx="{{index}}" bindtap="goTryAssignment">试做这份作业</button>

        <!-- 老师打开这一页真正要的三件事，按顺序给：谁没交 → 错哪几个词 → 错在哪。
             点名分两级（2026-10-10）：真没动的红标"还没完成"；词全学过但有忘词的
             黄标"忘词待巩固" —— 9/10·忘1 的孩子不该和 0/10 的混在同一句里挨催。 -->
        <view wx:if="{{item.pending}}" class="pending-line">
          <text class="pending-tag">还没完成</text>
          <text class="pending-names">{{item.pendingText}}</text>
        </view>
        <view wx:if="{{item.review}}" class="pending-line warn">
          <text class="pending-tag warn-tag">忘词待巩固</text>
          <text class="pending-names">{{item.reviewText}}</text>
        </view>
        <view wx:if="{{!item.pending && !item.review && !item.students}}" class="pending-line done">
          <text class="pending-tag ok">还没有学员加入</text>
        </view>
        <view wx:if="{{!item.pending && item.students}}" class="pending-line done">
          <text class="pending-tag ok">全班完成</text>
        </view>

      <view wx:if="{{item.hasWrongStat}}" class="wrong-box">
        <view class="wrong-line">
          <text class="muted">错得最多</text>
          <!-- chip 用 view+flex 而不是 text 套 text：外层 text 混排不同字号的子 text
               时行盒会被撑到两倍高（错词 chip 变大气泡的真正根因，2026-10-10 实锤） -->
          <view wx:for="{{item.wrongTop}}" wx:for-item="wt" wx:key="word" class="wt-chip">
            <text class="wt-word">{{wt.word}}</text>
            <text wx:if="{{wt.trans}}" class="wt-trans">{{wt.trans}}</text>
            <text class="wt-cnt">×{{wt.cnt}}</text>
          </view>
        </view>
        <view wx:if="{{item.mistakeTop.length}}" class="wrong-line">
          <text class="muted">错法</text>
          <view wx:for="{{item.mistakeTop}}" wx:for-item="mk" wx:key="key" class="wt-chip alt">
            <text class="wt-word">{{mk.key}}</text><text class="wt-cnt">×{{mk.cnt}}</text>
          </view>
        </view>
        <view wx:if="{{item.letterTop.length}}" class="wrong-line">
          <text class="muted">字母混淆</text>
          <view wx:for="{{item.letterTop}}" wx:for-item="lt" wx:key="key" class="wt-chip danger">
            <text class="wt-word">{{lt.key}}</text><text class="wt-cnt">×{{lt.cnt}}</text>
          </view>
        </view>
        <view class="muted why">依据 {{item.wrongCounted}} 条错拼记录（孩子下次联网后继续累积）</view>
      </view>

        <!-- 个性化透明化：每个孩子分到什么词、各自进度，一页看全（否则家长无从确认词单真的不同） -->
        <view wx:if="{{item.per_student.length}}" class="per-stu">
          <view class="per-stu-row head">
            <text class="per-stu-name muted">学员</text>
            <text class="per-stu-mid muted">完成 / 忘了</text>
            <text class="per-stu-words muted">词单与备注</text>
          </view>
          <view class="per-stu-row" wx:for="{{item.per_student}}" wx:for-item="ps" wx:key="user_id">
            <text class="per-stu-name {{ps.state === 'pending' ? 'bad-text' : (ps.state === 'review' ? 'warn-text' : 'ok-text')}}">{{ps.nickname}}</text>
            <text class="muted per-stu-mid">{{ps.done}}/{{ps.count}}{{ps.forgot ? ' · 忘 ' + ps.forgot : ''}}</text>
            <view class="per-stu-words">
              <text class="muted" style="font-size:22rpx">{{ps.wrong_top ? '错词 ' + ps.wrong_top + ' · ' : ''}}{{ps.skipped_mastered ? '跳过已掌握 ' + ps.skipped_mastered + ' · ' : ''}}{{ps.preview}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 学员 -->
    <view class="card">
      <view class="card-title">学员（{{students.length}}）</view>
      <view wx:if="{{stuError}}" class="muted mt-s">
        加载失败：{{stuError}}
        <text class="link" bindtap="reload"> 重试</text>
      </view>
      <!-- 每日简报：一句话讲清"今天学得怎样"，不用每天记得开小程序来看 -->
      <view class="muted mt-s" style="font-size:22rpx;line-height:1.6">
        点「订简报」并勾选「总是保持以上选择」，之后每天 20:30 会收到这个孩子的学习简报。{{briefNote}}
      </view>
      <view wx:if="{{briefCount}}" class="mt-s">
        <button class="btn ghost sm" bindtap="pushBriefNow">立刻发一次今天的简报</button>
      </view>
      <view wx:if="{{!students.length && !stuError}}" class="muted mt-s">
        还没有学员加入。把上面的邀请码发给孩子，等孩子输入后就出现在这里。
      </view>
      <view class="stu" wx:for="{{students}}" wx:key="id">
        <view class="stu-main" data-id="{{item.id}}" bindtap="openReport">
          <view class="stu-ava">{{item.nickname[0] || '学'}}</view>
          <view class="stu-mid">
            <!-- 名字 + 展开箭头（代替"（点看报告）"——箭头跟着开合转向，一眼知道能点） -->
            <view class="stu-name-row">
              <text class="stu-name">{{item.nickname}}</text>
              <text class="stu-arrow">▸</text>
            </view>
            <!-- 状态一行：状态图标 + 简短数据（长文案挪进展开的报告里，卡片只留一眼能扫完的） -->
            <view class="stu-status t-{{item.status.tone}}">
              {{item.status.icon}} {{item.status.label}}
            </view>
            <view class="muted" style="font-size:22rpx;opacity:.75">
              累计 {{item.stats.learned_words || 0}} 词<text wx:if="{{item.lastSeenText !== '还没来过'}}"> · {{item.lastSeenText}}活跃</text>
            </view>
          </view>
        </view>
        <button class="btn sm ghost" data-id="{{item.id}}" catchtap="makeNudge">催一催</button>
        <button class="btn sm {{briefSubs[item.id] ? 'ok' : 'ghost'}}"
                data-id="{{item.id}}" catchtap="toggleBrief">{{briefSubs[item.id] ? '✓ 已订简报' : '订简报'}}</button>
      </view>

      <!-- 学员报告：2026-10-10 起改成独立页（pages/report/report）。
           内联展开的版本越加越长，学员一多整页就乱，也没法打印/导出成图。 -->
    </view>

    <!-- 数据对不上时的自证入口：平时低调，需要时一页看全云端事实 -->
    <view class="card">
      <button class="btn ghost sm" bindtap="runDiagnose">云自检 · 数据对不上时点我</button>
      <button class="btn ghost sm mt-s" bindtap="runRepair">修复历史数据 · 学习记录找回</button>
      <view wx:if="{{diagnoseText}}" class="raw-err mt-s">{{diagnoseText}}</view>
    </view>
  </block>

  <!-- ===== 学生端 ===== -->
  <block wx:elif="{{my.role === 'student'}}">
    <view class="card">
      <view class="muted" style="font-size:24rpx">我加入的班级</view>
      <view class="t1">{{cls.name}}</view>
      <!-- 显示邀请码：和教练端的码一比对，立刻能发现"加了同名班"这种张冠李戴 -->
      <view class="muted" style="font-size:24rpx">邀请码 {{cls.code}}</view>
    </view>

    <view class="card" wx:if="{{myAssignError || myAssignments.length}}">
      <view class="card-title">老师 / 家长布置的任务</view>
      <view wx:if="{{myAssignError}}" class="muted mt-s">
        加载失败：{{myAssignError}}
        <text class="link" bindtap="reload"> 重试</text>
      </view>
      <view class="assign" wx:for="{{myAssignments}}" wx:key="id">
        <view class="row-between">
          <text class="assign-name">{{item.name || item.note || item.tag + '作业'}}</text>
          <text class="{{item.expired ? 'bad-text' : 'muted'}}" style="font-size:24rpx">
            {{item.expired ? '已过期 · ' : ''}}{{item.done}}/{{item.count}}
          </text>
        </view>
        <view class="bar"><view class="bar-in" style="width:{{item.count ? item.done * 100 / item.count : 0}}%"></view></view>
        <button class="btn sm mt-s {{item.done >= item.count ? 'ghost' : 'ok'}}"
                data-idx="{{index}}" bindtap="goStudyAssignment">
          {{item.done >= item.count ? '已完成，再去巩固' : '去做这份作业'}}
        </button>
      </view>
    </view>
    <view class="card" wx:else>
      <view wx:if="{{emptyHint === 'TEACHER_HAS_OTHER_CLASS'}}" class="muted" style="line-height:1.8">
        老师确实布置过作业，但不在你加入的这个班里——多半是班级重名，加错了班。
        <text class="link" bindtap="leaveConfirm">退出班级</text> 后用老师最新发的邀请码重新加入即可。
      </view>
      <view wx:else class="muted center">班里还没有布置任务，先按今日任务学习吧。</view>
    </view>

    <view class="card">
      <button class="btn ghost sm" bindtap="leaveConfirm">退出班级（换班用）</button>
      <button class="btn ghost sm mt-s" bindtap="runDiagnose">云自检 · 作业进度对不上时点我</button>
      <button class="btn ghost sm mt-s" bindtap="runRepair">修复历史数据 · 学习记录找回</button>
      <view wx:if="{{diagnoseText}}" class="raw-err mt-s">{{diagnoseText}}</view>
    </view>
  </block>

  <footer-nav active="class" />
</view>
