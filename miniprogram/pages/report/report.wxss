/* 学员学习报告（独立页，2026-10-10）
   版式目标：打印出来也不掉价 —— 大留白、分区清晰、一条分割线一个主题，
   不像聊天记录那样挤在一起。颜色沿用品牌蓝 + 中性灰，只在"错"上用红系。 */
.report { padding-top: 8rpx; }

/* 报告头 */
.rhead { display: flex; align-items: center; justify-content: space-between; }
.rh-left { display: flex; align-items: center; gap: 20rpx; }
.rh-ava {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: linear-gradient(135deg, #2b7fb8, #7c5cff);
  color: #fff; font-size: 44rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}
.rh-name { font-size: 38rpx; font-weight: 600; }
.rh-status {
  padding: 8rpx 18rpx; border-radius: 999rpx;
  font-size: 23rpx;
}
.rh-status.t-gray { color: var(--muted3); background: #1c2733; }
.rh-status.t-amber { color: #ffd88a; background: #2b2416; }
.rh-status.t-green { color: #7fd6a0; background: #16301f; }

/* 三个核心数字 */
.kpi-row2 { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.kpi2 {
  flex: 1;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 22rpx 18rpx;
  text-align: center;
}
.kpi2 .num { font-size: 46rpx; font-weight: 700; color: var(--text); }
.kpi2 .label { margin-top: 6rpx; font-size: 22rpx; color: var(--muted3); }

/* 简报 / 荣誉 */
.sum-text { font-size: 28rpx; line-height: 1.7; color: var(--text); }
.honor-box {
  margin-top: 18rpx; padding: 18rpx 20rpx;
  background: #16301f; border: 1rpx solid #24563a; border-radius: 14rpx;
}
.honor-badge { font-size: 30rpx; font-weight: 600; color: #7fd6a0; }
.honor-detail { margin-top: 8rpx; font-size: 24rpx; color: #a9c8b6; }
.loop-tip {
  margin-top: 18rpx; padding: 16rpx 20rpx;
  background: #2b2416; border-radius: 14rpx;
  color: #ffd88a; font-size: 24rpx;
}

/* 作业完成度 */
.ra { margin-top: 20rpx; }
.ra-name { font-size: 26rpx; display: flex; align-items: center; flex-wrap: wrap; }
.tag-mini {
  margin-left: 12rpx; padding: 2rpx 10rpx; border-radius: 999rpx;
  font-size: 20rpx; color: #cdbcff; background: #2b2438;
}
.bar { margin-top: 10rpx; height: 12rpx; border-radius: 999rpx; background: var(--line3); overflow: hidden; }
.bar-in { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, var(--accent), #7c5cff); }
.bar-in.ok { background: linear-gradient(90deg, #2fd07a, #34a86a); }

/* 错因 chip（与班级页同款：禁换行，防止释义撑成大气泡） */
.chip-line { display: flex; flex-wrap: wrap; align-items: center; margin-top: 12rpx; }
/* view + flex 定高：不再依赖 text 行盒（text 套不同字号的 text 会把行盒撑到两倍高） */
.wt-chip {
  display: flex;
  align-items: center;
  height: 44rpx;
  margin: 4rpx 8rpx 4rpx 0;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: var(--text3);
  background: var(--line3);
  line-height: 1;
  max-width: 100%;
  overflow: hidden;
}
.wt-chip .wt-word { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-shrink: 1; }
.wt-trans { margin-left: 6rpx; font-size: 20rpx; color: var(--muted4); }
.wt-cnt { margin-left: 6rpx; font-size: 20rpx; color: #ffb020; }
.wt-chip.alt { background: #2b2438; color: #cdbcff; }
.wt-chip.danger { background: #3a2028; color: #ffb0b0; }

/* 最近评分 */
.rlog { display: flex; align-items: flex-start; gap: 14rpx; padding: 14rpx 0; border-bottom: 1rpx solid #1e2a37; }
.rlog:last-child { border-bottom: 0; }
.log-mark { font-size: 26rpx; }
.log-mark.ok { color: #7fd6a0; }
.log-mark.bad { color: #ff5c72; }
.rlog-mid { flex: 1; min-width: 0; }
.rlog-word { font-size: 26rpx; }
.rlog-typed { margin-top: 4rpx; font-size: 22rpx; color: #ffb0b0; }

/* 外发区 */
.acts .btn { margin-top: 16rpx; }

/* 长图画布：放到屏幕外，只做导出用（截不到图但也不占版面） */
.off-canvas {
  position: fixed;
  left: -9999rpx; top: 0;
  width: 750rpx; height: 1600rpx;
}
