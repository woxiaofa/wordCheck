/* 设置页 —— 皮肤卡横向排列，迷你预览用皮肤 token 真值渲染，不用切图 */

.skins {
  white-space: nowrap;
  margin: 0 -8rpx;
  padding: 4rpx 8rpx;
}

.skin {
  display: inline-block;
  width: 190rpx;
  margin-right: 16rpx;
  padding: 12rpx;
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  background: var(--surface2);
  vertical-align: top;
  white-space: normal;
}
.skin.on { border-color: var(--accent); }
.skin.locked { opacity: .62; }

.mini {
  height: 220rpx;
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  overflow: hidden;
  padding: 10rpx;
  box-sizing: border-box;
}
.mini-bar { height: 22rpx; border-radius: 8rpx; }
.mini-card {
  margin-top: 12rpx;
  height: 150rpx;
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  padding: 14rpx 12rpx;
  box-sizing: border-box;
}
.mini-line { height: 12rpx; border-radius: 6rpx; margin-bottom: 12rpx; }
.mini-line.w70 { width: 70%; }
.mini-line.w45 { width: 45%; }
.mini-btn { margin-top: 26rpx; height: 40rpx; border-radius: 10rpx; }

.skin-name { margin-top: 10rpx; font-size: 26rpx; font-weight: 600; }
.skin-tag { margin-top: 4rpx; font-size: 20rpx; color: var(--accent); }
.skin.locked .skin-tag { color: var(--muted); }
.skin-desc { margin-top: 4rpx; font-size: 19rpx; color: var(--muted); line-height: 1.5; }

.unlock-line { font-size: 24rpx; color: var(--text3); }
.unlock-line .num { color: var(--accent); font-weight: 600; }
.hint { margin-top: 6rpx; font-size: 20rpx; }

/* 入口行 */
.row-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--line6);
}
.row-item + .row-item { border-top: 0; }
.ri-t { font-size: 30rpx; font-weight: 600; }
.ri-d { margin-top: 4rpx; font-size: 22rpx; color: var(--muted); line-height: 1.5; }
.ri-arrow { font-size: 40rpx; color: var(--muted); margin-left: 16rpx; }
