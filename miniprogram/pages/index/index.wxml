<!-- 今日任务：一眼回答三个问题——做多少、都是什么词、现在点哪里 -->
<view class="page">

  <!-- 首次使用：一句话价值 + 一个动作。非阻断、可关闭、永不再现（新手引导第 1 段） -->
  <view class="card intro" wx:if="{{intro}}">
    <view class="t1">每天 5 分钟，{{target}} 个词</view>
    <view class="muted mt-s">
      今天该复习什么，系统按遗忘曲线排好了，你只需要开始。
      先学习、后抽查，答对的词隔更久再出现。
    </view>
    <button class="btn mt" bindtap="goStudy">开始学第 1 轮</button>
    <view class="link center mt-s" bindtap="toggleHowto">先看看它怎么运作</view>
    <view class="intro-close" bindtap="dismissIntro">✕</view>
  </view>

  <!-- 词书选择：只在这一本里出任务。
       切换词书不会清空进度（SRS 状态是按单词存的），切回来接着学。 -->
  <view class="card books">
    <view class="row-between">
      <text class="books-title">词库：{{bookName}}</text>
      <text class="muted" style="font-size:24rpx">{{bookCount}} 个词</text>
    </view>
    <view class="book-chips">
      <view
        wx:for="{{books}}"
        wx:key="key"
        class="book-chip {{item.key === bookKey ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="onSelectBook"
      >{{item.name}}</view>
    </view>
    <view class="muted center mt-s" style="font-size:24rpx">
      {{bookDesc}} · 换词库不会清除已记住的词
    </view>
  </view>

  <!-- 作业未完成时取代每日任务卡：孩子的注意力只该有一个入口，两份任务并排会互相打架 -->
  <view class="card hero cls-hero" wx:if="{{clsAssign && !clsAssign.finished}}">
    <view class="hero-label">📌 {{clsAssign.name}}</view>
    <view class="hero-num">{{clsAssign.done}}<text class="hero-unit"> / {{clsAssign.count}} 个词</text></view>
    <view class="progress mt-s">
      <view class="progress-inner" style="width:{{clsAssign.count ? clsAssign.done * 100 / clsAssign.count : 0}}%"></view>
    </view>
    <button class="btn ok mt" bindtap="goClassAssign">继续学</button>
    <button class="btn ghost mt-s" bindtap="goQuiz">去抽查</button>
  </view>

  <!-- 任务卡：量 + 构成 + 每一项"为什么是它"。作业没完成时让位（见上） -->
  <view class="card hero" wx:if="{{!clsAssign || clsAssign.finished}}">
    <view class="hero-label">{{taskDone ? '今天已完成，可自由加练' : '今天的任务'}}</view>
    <view class="hero-num">{{totalCount}} <text class="hero-unit">个词</text></view>
    <view class="hero-sub">大约 {{minutes}} 分钟，一次学完</view>

    <view class="task-list">
      <view class="task-item" wx:if="{{dueCount}}">
        <text class="task-num">{{dueCount}}</text>
        <view class="task-desc">
          <text class="task-name">到期复习</text>
          <text class="task-why">之前学过，今天到了快忘的时间点</text>
        </view>
      </view>
      <view class="task-item" wx:if="{{wrongCount}}">
        <text class="task-num">{{wrongCount}}</text>
        <view class="task-desc">
          <text class="task-name">错词</text>
          <text class="task-why">之前答错过，今天再看一遍</text>
        </view>
      </view>
      <view class="task-item" wx:if="{{newCount}}">
        <text class="task-num">{{newCount}}</text>
        <view class="task-desc">
          <text class="task-name">新词</text>
          <text class="task-why">第一次见面，混个脸熟</text>
        </view>
      </view>
      <view class="task-item" wx:if="{{!totalCount}}">
        <view class="task-desc">
          <text class="task-name">暂时没有排队的词</text>
          <text class="task-why">学过的词都排进复习计划了，还没到复习时间。去抽查检验真实掌握程度</text>
        </view>
      </view>
    </view>

    <button class="btn" bindtap="goStudy">{{mainBtnText}}</button>
    <!-- 文案别超过一行：按钮里换行非常难看。"交卷才判分"的说明抽查页开场就有，这里不重复 -->
    <button class="btn ghost mt-s" bindtap="goQuiz">去抽查 · 检验真实水平</button>
  </view>

  <!-- 班级作业（已完成）：降级为普通入口，不打扰 -->
  <view class="card cls-assign" wx:if="{{clsAssign && clsAssign.finished}}">
    <view class="row-between">
      <text class="card-title">📌 {{clsAssign.name}}</text>
      <text class="muted">{{clsAssign.done}}/{{clsAssign.count}}</text>
    </view>
    <view class="progress mt-s">
      <view class="progress-inner" style="width:{{clsAssign.count ? clsAssign.done * 100 / clsAssign.count : 0}}%"></view>
    </view>
    <button class="btn sm mt-s {{clsAssign.finished ? 'ghost' : 'ok'}}" bindtap="goClassAssign">
      {{clsAssign.finished ? '已完成，再去巩固' : '继续学 · 从没学的词开始'}}
    </button>
  </view>

  <view class="grid-3">
    <view class="kpi">
      <view class="num">{{streak}}</view>
      <view class="label">连续打卡</view>
    </view>
    <view class="kpi">
      <view class="num">{{mastery}}%</view>
      <view class="label">掌握率</view>
    </view>
    <view class="kpi">
      <view class="num">{{learned}}</view>
      <view class="label">已学词</view>
    </view>
  </view>

  <!-- 今日进度：作业进行中时隐藏——作业卡上的进度条就是当前唯一的进度，
       两个进度条并排（20/20 完成 vs 作业 0/10）只会让人觉得数字错了 -->
  <view class="card mt" wx:if="{{!clsAssign || clsAssign.finished}}">
    <view class="row-between">
      <text class="card-title">今日进度</text>
      <text class="muted">{{done}} / {{target}}</text>
    </view>
    <view class="progress mt-s">
      <view class="progress-inner" style="width:{{progressPct}}%"></view>
    </view>
    <view class="muted mt-s">{{progressNote}}</view>
  </view>

  <!-- 怎么做：三步讲清动作，不谈概念 -->
  <view class="card">
    <view class="row-between">
      <text class="card-title">今天怎么学</text>
      <text class="link" bindtap="toggleHowto">{{howtoOpen ? '收起' : '这是什么原理'}}</text>
    </view>
    <view class="steps mt-s">
      <view class="step">
        <text class="step-no">1</text>
        <view class="step-body">
          <text class="step-t">看单词，先想意思</text>
          <text class="step-d">别急着翻面，先在心里说一遍它是什么意思</text>
        </view>
      </view>
      <view class="step">
        <text class="step-no">2</text>
        <view class="step-body">
          <text class="step-t">点开看答案，如实评价</text>
          <text class="step-d">想得很快 / 想起来但费劲 / 没想起来，三个里选一个</text>
        </view>
      </view>
      <view class="step">
        <text class="step-no">3</text>
        <view class="step-body">
          <text class="step-t">学完去抽查</text>
          <text class="step-d">抽查答对的词 15 天后再见，答错的 10 分钟后回来</text>
        </view>
      </view>
    </view>
    <view class="howto-more" wx:if="{{howtoOpen}}">
      每个词都有一条自己的复习时间线：你越熟练，它出现得越少
      （10 分钟 → 1 天 → 4 天 → … → 120 天）。评价越如实，排期越准，
      所以在"想起来了但费劲"时别选"想得很快"——那只会骗过系统，让你重复背已经会的词。
    </view>
  </view>

  <!-- 教练/家长（班级创建者）：只给"看学员进度"的入口，不给他们发作业卡 -->
  <view class="card cls-assign" wx:if="{{coachCls}}">
    <view class="row-between">
      <text class="card-title">👨‍👩‍👧 {{coachCls.name}}</text>
      <text class="muted">我是布置作业的人</text>
    </view>
    <view class="muted mt-s">你自己背单词按默认词库走，班级作业不会占用你的今日任务。</view>
    <button class="btn ghost sm mt-s" bindtap="goClass">去看学员进度</button>
  </view>

  <!-- 学习流水：把"我做了什么 → 进度有没有往前走"逐条摆出来，不靠猜 -->
  <view class="card mt">
    <view class="row-between">
      <text class="card-title">学习流水</text>
      <text class="link" bindtap="copyLearnLog">复制</text>
    </view>
    <view class="muted mt-s" bindtap="toggleRule">
      进度口径：学过即算 —— 每个词评价一次（认识/模糊/忘了都算）就计入作业完成，抽查对错不影响。
      <text class="link">{{ruleOpen ? '收起' : '举例'}}</text>
    </view>
    <view class="muted mt-s" wx:if="{{ruleOpen}}">
      例：作业 10 个词，点"继续学"后每个词翻面 + 任选一个评价 = 该词完成，10 个词都评价过就是 10/10。
      流水里出现"云端✗"表示这次评分还没同步上云（会自动补传），进度条要等补传成功才会动。
    </view>

    <view wx:if="{{!learnLog.length}}" class="muted mt-s">还没有学习记录。去学几个词，这里会逐条显示云端是否确认。</view>
    <view wx:for="{{learnLog}}" wx:key="id" class="log-row">
      <text class="log-time">{{item.time}}</text>
      <text class="log-word">{{item.word}}</text>
      <text class="log-mode">{{item.mode}}<text wx:if="{{item.assign}}">·{{item.assign}}</text></text>
      <text class="log-fb">{{item.feedback}}</text>
      <text class="log-cloud {{item.cloud}}">{{item.cloudTxt}}</text>
    </view>
  </view>

  <footer-nav active="index" />
</view>
