.hero { text-align: center; padding: 40rpx 28rpx; }

/* ---- 词书选择 ---- */
.books { padding: 24rpx 28rpx; margin-bottom: 20rpx; }
.books-title { font-size: 28rpx; font-weight: 700; }
.book-chips { display: flex; flex-wrap: wrap; margin-top: 18rpx; }
.book-chip {
  padding: 12rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
  color: #8fa3b7;
  background: #131c27;
  border: 1rpx solid #2b3949;
  border-radius: 999rpx;
}
.book-chip.on {
  color: #ffffff;
  font-weight: 600;
  background: rgba(62, 166, 255, .16);
  border-color: #3ea6ff;
}

.hero-label { color: #8fa3b7; font-size: 26rpx; }
.hero-num { margin-top: 12rpx; font-size: 76rpx; font-weight: 700; line-height: 1.1; }
.hero-unit { font-size: 30rpx; font-weight: 400; color: #8fa3b7; }
.hero-sub { margin: 12rpx 0 28rpx; color: #8fa3b7; font-size: 26rpx; }
.mt-s { margin-top: 16rpx; }

/* ---- 任务构成列表：数字 + 名称 + 一句"为什么" ---- */
.task-list {
  margin: 0 0 28rpx;
  padding: 20rpx 24rpx;
  background: #131c27;
  border-radius: 20rpx;
  text-align: left;
}
.task-item { display: flex; align-items: flex-start; padding: 12rpx 0; }
.task-item + .task-item { border-top: 1rpx dashed #26313f; }
.task-num {
  min-width: 64rpx; margin-top: 4rpx;
  font-size: 34rpx; font-weight: 700; color: #3ea6ff;
}
.task-desc { display: flex; flex-direction: column; }
.task-name { font-size: 28rpx; font-weight: 600; color: #e8eef5; }
.task-why { font-size: 24rpx; color: #8fa3b7; margin-top: 4rpx; }

/* ---- 首次使用引导卡 ---- */
.intro { position: relative; padding: 36rpx 28rpx; border-color: #3ea6ff; }
.intro-close {
  position: absolute; top: 20rpx; right: 24rpx;
  width: 52rpx; height: 52rpx; line-height: 52rpx;
  text-align: center; color: #8fa3b7; font-size: 30rpx;
}
.link { color: #3ea6ff; font-size: 26rpx; }

/* ---- 三步说明 ---- */
.steps { text-align: left; }
.step { display: flex; align-items: flex-start; padding: 14rpx 0; }
.step-no {
  min-width: 44rpx; height: 44rpx; line-height: 44rpx; margin-top: 4rpx;
  border-radius: 50%; text-align: center;
  background: #1f304a; color: #3ea6ff; font-size: 26rpx; font-weight: 700;
}
.step-body { display: flex; flex-direction: column; }
.step-t { font-size: 28rpx; font-weight: 600; }
.step-d { font-size: 24rpx; color: #8fa3b7; margin-top: 4rpx; }

/* ---- 原理展开区 ---- */
.howto-more {
  margin-top: 16rpx; padding: 20rpx 24rpx;
  background: #131c27; border-radius: 16rpx;
  font-size: 24rpx; color: #8fa3b7; line-height: 1.7;
}

/* 班级作业入口卡：紫色描边和作业模式的学习页进度条同一色系 */
.cls-assign { border: 1rpx solid rgba(124, 92, 255, .35); }
/* 作业取代任务卡时的主卡样式：带一点紫色描边表明"这是老师布置的" */
.cls-hero { border: 1rpx solid rgba(124, 92, 255, .45); }

/* ---- 学习流水：一行一条，"我做了什么 + 云端确认没有" ---- */
.log-row {
  display: flex; align-items: center;
  padding: 12rpx 0; font-size: 24rpx;
  border-top: 1rpx dashed #26313f;
}
.log-time { width: 140rpx; color: #8fa3b7; }
.log-word { flex: 1; font-weight: 600; color: #e8eef5; }
.log-mode { color: #8fa3b7; margin-right: 12rpx; font-size: 22rpx; }
.log-fb { color: #8fa3b7; margin-right: 12rpx; }
.log-cloud {
  padding: 4rpx 14rpx; border-radius: 999rpx;
  font-size: 22rpx; color: #8fa3b7; background: #131c27;
}
.log-cloud.ok { color: #4cd08a; background: rgba(76, 208, 138, .14); }
.log-cloud.fail { color: #ff7b7b; background: rgba(255, 123, 123, .14); }

/* 掌握率口径说明：学过词但 0% 掌握时出现，防止被当成数字 bug */
.kpi-note {
  font-size: 20rpx; color: #8fa3b7; opacity: .8;
  padding: 0 12rpx; margin-top: 10rpx; text-align: center;
}
