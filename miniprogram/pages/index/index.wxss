.hero { text-align: center; padding: 40rpx 28rpx; }

/* ---- 词书选择 ---- */
.books { padding: 24rpx 28rpx; margin-bottom: 20rpx; }
.books-title { font-size: 28rpx; font-weight: 700; }
.book-chips { display: flex; flex-wrap: wrap; gap: 14rpx 16rpx; margin-top: 18rpx; }
.book-chip {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: var(--muted);
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
}
/* 选中态：原来白字叠在 rgba(62,166,255,.16) 上 —— 深色下看着还行，
   浅色皮肤下 16% 的蓝几乎铺不满粉底，白字直接糊掉。改用强调色那一组 token，
   夜色是蓝底浅蓝字（与旧观感一致），浅色是淡蓝底深蓝字。 */
.book-chip.on {
  color: var(--accent-soft);
  font-weight: 600;
  background: var(--accent-bg);
  border-color: var(--accent);
}

.hero-label { color: var(--muted); font-size: 26rpx; }
.hero-num { margin-top: 12rpx; font-size: 76rpx; font-weight: 700; line-height: 1.1; }
.hero-unit { font-size: 30rpx; font-weight: 400; color: var(--muted); }
.hero-sub { margin: 12rpx 0 28rpx; color: var(--muted); font-size: 26rpx; }
.mt-s { margin-top: 16rpx; }

/* ---- 任务构成列表：数字 + 名称 + 一句"为什么" ---- */
.task-list {
  margin: 0 0 28rpx;
  padding: 20rpx 24rpx;
  background: var(--panel);
  border-radius: 20rpx;
  text-align: left;
}
.task-item { display: flex; align-items: flex-start; padding: 12rpx 0; }
.task-item + .task-item { border-top: 1rpx dashed var(--line4); }
.task-num {
  min-width: 64rpx; margin-top: 4rpx;
  font-size: 34rpx; font-weight: 700; color: var(--accent);
}
.task-desc { display: flex; flex-direction: column; }
.task-name { font-size: 28rpx; font-weight: 600; color: var(--text); }
.task-why { font-size: 24rpx; color: var(--muted); margin-top: 4rpx; }

/* ---- 首次使用引导卡 ---- */
.intro { position: relative; padding: 36rpx 28rpx; border-color: var(--accent); }
.intro-close {
  position: absolute; top: 20rpx; right: 24rpx;
  width: 52rpx; height: 52rpx; line-height: 52rpx;
  text-align: center; color: var(--muted); font-size: 30rpx;
}
.link { color: var(--accent); font-size: 26rpx; }

/* ---- 三步说明 ---- */
.steps { text-align: left; }
.step { display: flex; align-items: flex-start; padding: 14rpx 0; }
.step-no {
  min-width: 44rpx; height: 44rpx; line-height: 44rpx; margin-top: 4rpx;
  border-radius: 50%; text-align: center;
  background: var(--surface2); color: var(--accent); font-size: 26rpx; font-weight: 700;
}
.step-body { display: flex; flex-direction: column; }
.step-t { font-size: 28rpx; font-weight: 600; }
.step-d { font-size: 24rpx; color: var(--muted); margin-top: 4rpx; }

/* ---- 原理展开区 ---- */
.howto-more {
  margin-top: 16rpx; padding: 20rpx 24rpx;
  background: var(--panel); border-radius: 16rpx;
  font-size: 24rpx; color: var(--muted); line-height: 1.7;
}

/* 班级作业入口卡：紫色描边和作业模式的学习页进度条同一色系 */
.cls-assign { border: 1rpx solid rgba(124, 92, 255, .35); }
/* 作业取代任务卡时的主卡样式：带一点紫色描边表明"这是老师布置的" */
.cls-hero { border: 1rpx solid rgba(124, 92, 255, .45); }

/* ---- 学习流水：一行一条，"我做了什么 + 云端确认没有" ---- */
.log-row {
  display: flex; align-items: center;
  padding: 12rpx 0; font-size: 24rpx;
  border-top: 1rpx dashed var(--line4);
}
.log-time { width: 140rpx; color: var(--muted); }
.log-word { flex: 1; font-weight: 600; color: var(--text); }
.log-mode { display: flex; align-items: center; color: var(--muted); margin-right: 12rpx; font-size: 22rpx; }
.log-fb { color: var(--muted); margin-right: 12rpx; }
.log-cloud {
  padding: 4rpx 14rpx; border-radius: 999rpx;
  font-size: 22rpx; color: var(--muted); background: var(--panel);
}
.log-cloud.ok { color: var(--ok-soft); background: rgba(76, 208, 138, .14); }
.log-cloud.fail { color: var(--bad-soft2); background: rgba(255, 123, 123, .14); }

/* 掌握率口径说明：学过词但 0% 掌握时出现，防止被当成数字 bug */
.kpi-note {
  font-size: 20rpx; color: var(--muted); opacity: .8;
  padding: 0 12rpx; margin-top: 10rpx; text-align: center;
}

/* 今日学习简报 */
.summary-text { font-size: 28rpx; line-height: 1.7; }
.honor {
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: linear-gradient(90deg, var(--honor-a), var(--honor-b));
  border: 2rpx solid var(--gold-line);
}
.honor-badge { font-size: 30rpx; font-weight: 700; color: var(--gold-text); }
.honor-detail { font-size: 22rpx; color: var(--honor-soft); margin-top: 6rpx; }
.loop-tip { margin-top: 10rpx; font-size: 22rpx; color: var(--bad-soft); }

/* 离线练习提示：断网时孩子也能接着练，这里只是把"为什么家长那边数字没变"说清 */
.offline-tip {
  margin-top: 10rpx;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  background: var(--gold-bg2);
  border: 1rpx solid var(--gold-line2);
  color: var(--warn-text);
  font-size: 22rpx;
  line-height: 1.5;
}
.sync-card { padding: 16rpx 24rpx; }

/* iPad 横屏提示（utils/fit.js 检测） */
.rotate-tip {
  background: #FFF7E6;
  color: #8A6116;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  text-align: center;
}

/* 底部反馈入口：比设置页那颗更克制，首页内容已经很满，
   用 ghost 描边小按钮避免抢主操作的注意力 */
.home-feedback { text-align: center; padding: 4rpx 0 0; }
.home-feedback-btn { margin-top: 16rpx; }

/* 词库引导：紧跟「添加词库」入口，解释"没有我要的教材怎么办"。
   行高放宽一点，两行文字在窄屏上不挤在一起 */
.home-guide { font-size: 22rpx; line-height: 1.7; opacity: .75; padding: 0 20rpx; }

