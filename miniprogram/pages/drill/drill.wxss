/* 快刷页样式：一屏一件事——看清词、选意思、看结果 */

.drill .bar { margin-bottom: 12rpx; }
.tag-line { font-size: 26rpx; color: #8fa3b7; }

/* 题目卡：一屏一题 —— 词在上方大字展示，选项贴底（拇指够得着） */
.qcard {
  display: flex;
  flex-direction: column;
  /* 扣掉顶栏+进度条+底部导航，让卡片基本占满一屏 */
  min-height: calc(100vh - 400rpx);
  box-sizing: border-box;
  padding: 40rpx 28rpx;
}
.qword-row { display: flex; align-items: center; justify-content: center; }
.qword {
  font-size: 100rpx; font-weight: 800; letter-spacing: 2rpx;
  color: #e8eef5; word-break: break-all; text-align: center;
}
.speaker { font-size: 44rpx; margin-left: 16rpx; opacity: .75; }
/* 拼写/听写题没有大字单词，顶部提示用小一号 */
.qword-hint { font-size: 48rpx; letter-spacing: 0; color: #8fa3b7; }
.qph { text-align: center; color: #8fa3b7; font-size: 28rpx; margin-top: 8rpx; }
.qstem { text-align: center; font-size: 34rpx; margin-top: 20rpx; }

/* 选项/键盘区：推到卡片底部 */
.qbody { margin-top: auto; }

/* 选项：首轮两个、循环轮四个，都是大块，好点 */
.opt {
  margin-top: 20rpx;
  padding: 30rpx 26rpx;
  background: #1e2a38;
  border: 2rpx solid #2b3949;
  border-radius: 20rpx;
  font-size: 32rpx;
  line-height: 1.5;
  text-align: center;
}
.opt:active { background: #24344a; }
.opt.right { border-color: #2fd07a; background: #17324a; }
.opt.wrong { border-color: #ff5c72; background: #3a1f2a; }

/* 拼写/听写输入区 */
.typed {
  margin-top: 24rpx;
  min-height: 80rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; font-weight: 700; letter-spacing: 4rpx;
  color: #3ea6ff;
  background: #16202c; border-radius: 16rpx; border: 2rpx dashed #2b3949;
}

.typed-full { border-style: solid; color: #e8eef5; letter-spacing: 6rpx; }

/* 答对后短暂的高亮：让"换词"看得见 */
.qcard.flash { border-color: #2fd07a; }

.slow-hint {
  margin-top: 20rpx; text-align: center;
  font-size: 24rpx; color: #ffb020;
}

/* 详情（答错/超时后看一眼这个词）：卡片充满一屏，按钮钉底 */
.detail-card {
  display: flex;
  flex-direction: column;
  min-height: calc(100vh - 400rpx);
  box-sizing: border-box;
  padding: 36rpx 28rpx;
}
.detail-bottom { margin-top: auto; }
.dflag {
  display: inline-block; padding: 6rpx 16rpx; border-radius: 99rpx;
  font-size: 24rpx; background: #3a1f2a; color: #ff8a9c; margin-bottom: 20rpx;
  align-self: flex-start;
}
.ddef {
  margin-top: 20rpx; text-align: center;
  font-size: 44rpx; font-weight: 600; color: #3ea6ff;
}
.dex { margin-top: 24rpx; padding: 22rpx; background: #16202c; border-radius: 16rpx; }
.dex-en { font-size: 30rpx; line-height: 1.6; }
.dex-cn { margin-top: 6rpx; font-size: 26rpx; color: #8fa3b7; line-height: 1.6; }
.dyour { margin-top: 18rpx; text-align: center; font-size: 26rpx; color: #ffb020; }

/* 宽屏（iPad / 折叠展开 / PC）：rpx 会被放大，收回 px 比例 */
.wide .qcard, .wide .detail-card { min-height: calc(100vh - 260px); padding: 20px; }
.wide .qword { font-size: 48px; }
.wide .speaker { font-size: 22px; }
.wide .qph { font-size: 14px; }
.wide .qstem { font-size: 17px; }
.wide .opt { padding: 15px 13px; font-size: 16px; border-radius: 10px; margin-top: 10px; }
.wide .dflag { font-size: 12px; padding: 3px 8px; }
.wide .ddef { font-size: 22px; }
.wide .dex-en { font-size: 15px; }
.wide .dex-cn { font-size: 13px; }
.wide .dyour { font-size: 13px; }

/* 完成态 */
.done-emoji { font-size: 88rpx; }
.done-title { font-size: 40rpx; font-weight: 700; margin-top: 8rpx; }
.done-sub { margin-top: 10rpx; font-size: 28rpx; color: #8fa3b7; }
.kpi-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }

/* 错题本 */
.wb { margin-top: 28rpx; text-align: left; }
.wb-title { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.wb-list { display: flex; flex-wrap: wrap; }
.wb-item {
  width: 100%;
  display: flex; align-items: baseline;
  padding: 12rpx 0; border-bottom: 1rpx dashed #2b3949;
}
.wb-w { font-size: 30rpx; font-weight: 600; width: 240rpx; }
.wb-d { font-size: 26rpx; color: #8fa3b7; flex: 1; }

/* 「不会」诚实按钮：次要但不隐藏 —— 不会就该有地方说，而不是逼着瞎蒙 */
.honest {
  margin-top: 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  color: #8fa3b7;
  background: transparent;
  border: 2rpx dashed #3a4a5e;
  border-radius: 16rpx;
}
.honest::after { border: none; }

/* 键盘难度说明：让家长知道"变简单"是设计，不是坏了 */
.kb-meta { margin-top: 12rpx; text-align: center; font-size: 22rpx; color: #7b8ea3; }

/* 详情页跟读引导：只看不念记不住，这里明确鼓励多听几遍 */
.read-guide {
  margin-top: 24rpx; padding: 20rpx 22rpx;
  background: #16202c; border-radius: 16rpx;
  border-left: 6rpx solid #3ea6ff;
}
.rg-text { font-size: 28rpx; color: #cfe0f0; line-height: 1.6; }
.rg-count { margin-top: 8rpx; font-size: 22rpx; color: #3ea6ff; }

/* 荣誉 / 排名 */
.honor {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #3a2f10, #2a2a1c);
  border: 2rpx solid #7a6320;
}
.honor-badge { font-size: 34rpx; font-weight: 700; color: #ffd166; }
.honor-detail { font-size: 22rpx; color: #c9b98a; margin-top: 6rpx; }

/* 昵称 / 头像（榜单展示用，用户自愿填） */
.profile-card {
  margin-top: 24rpx; padding: 20rpx;
  background: #16202c; border-radius: 16rpx; text-align: left;
}
.prow { display: flex; align-items: center; margin-top: 16rpx; }
.avatar-btn {
  width: 96rpx; height: 96rpx; padding: 0; margin: 0;
  border-radius: 50%; overflow: hidden;
  background: #243040; border: 2rpx solid #3a4a5e;
  display: flex; align-items: center; justify-content: center;
}
.avatar-btn::after { border: none; }
.avatar-img { width: 96rpx; height: 96rpx; }
.avatar-ph { font-size: 40rpx; color: #8fa3b7; }

/* 宽屏：rpx 放大后收回 px */
.wide .honest { margin-top: 12px; height: 38px; line-height: 38px; font-size: 13px; }
.wide .kb-meta { font-size: 11px; }
.wide .read-guide { padding: 12px; }
.wide .rg-text { font-size: 15px; }
.wide .honor { padding: 12px; }
.wide .honor-badge { font-size: 18px; }
.wide .avatar-btn, .wide .avatar-img { width: 52px; height: 52px; }
