<!-- 数据看板与错词本 -->
<view class="page {{layoutWide ? 'wide' : ''}} {{skin}}" style="{{layoutStyle}}">

  <!-- ===== 日报 / 周报 / 月报 ===== -->
  <view class="rpt-tabs">
    <view
      wx:for="{{ranges}}"
      wx:key="key"
      class="rpt-tab {{range === item.key ? 'on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onRange"
    >{{item.name}}</view>
  </view>

  <view wx:if="{{rpt}}" class="card rpt">
    <view class="row-between">
      <text class="card-title">{{rpt.rangeLabel}}</text>
      <text class="muted" wx:if="{{rpt.bestDay}}">最多 {{rpt.bestDay.total}} 题</text>
    </view>
    <view class="muted mt-s">{{rpt.subLabel}}</view>

    <view class="rpt-kpis">
      <view class="rpt-kpi">
        <view class="n">{{rpt.total}}</view>
        <view class="l">练习题数</view>
      </view>
      <view class="rpt-kpi">
        <view class="n">{{rpt.rate}}%</view>
        <view class="l">答对率</view>
        <view wx:if="{{rpt.delta !== null}}" class="d {{rpt.deltaUp ? 'up' : 'down'}}">{{rpt.deltaText}}</view>
      </view>
      <view class="rpt-kpi">
        <view class="n">{{rpt.activeDays}}</view>
        <view class="l">活跃天数</view>
        <view class="d">/ {{rpt.days}} 天</view>
      </view>
    </view>

    <!-- 日报：看今天的构成；周/月报：看逐日趋势 -->
    <view wx:if="{{rpt.days === 1}}" class="rpt-split">
      <view class="rpt-split-bar">
        <view class="seg known" style="width:{{rpt.known / (rpt.total || 1) * 100}}%"></view>
        <view class="seg vague" style="width:{{rpt.vague / (rpt.total || 1) * 100}}%"></view>
        <view class="seg forgot" style="width:{{rpt.forgot / (rpt.total || 1) * 100}}%"></view>
      </view>
      <view class="rpt-legend">
        <!-- 圆点是有宽高的块，放进 text 里尺寸不生效/撑行盒 → 外层一律 view -->
        <view class="legend-item"><view class="dot known"></view><text>答对 {{rpt.known}}</text></view>
        <view class="legend-item"><view class="dot vague"></view><text>模糊 {{rpt.vague}}</text></view>
        <view class="legend-item"><view class="dot forgot"></view><text>忘了 {{rpt.forgot}}</text></view>
      </view>
    </view>
    <view wx:else class="rpt-bars">
      <view
        wx:for="{{rpt.series}}"
        wx:key="date"
        class="rpt-bar"
        data-date="{{item.date}}"
        data-total="{{item.total}}"
        bindtap="onBarTap"
      >
        <view class="rpt-bar-track">
          <view class="rpt-bar-fill {{item.total ? '' : 'empty'}}" style="height:{{item.height}}%"></view>
        </view>
        <text class="rpt-bar-day">{{item.label}}</text>
      </view>
    </view>

    <view class="rpt-note">{{rpt.headline}}</view>

    <view wx:if="{{rpt.topWrong.length}}" class="rpt-wrong">
      <text class="rpt-subtitle">高频错词</text>
      <view wx:for="{{rpt.topWrong}}" wx:key="word" class="rpt-wrong-line">
        <view class="rpt-wrong-mid">
          <text class="wrong-word">{{item.word}}</text>
          <text class="muted">{{item.def}}</text>
        </view>
        <text class="badge {{item.wrong >= 3 ? 'hi' : 'lo'}}">错 {{item.wrong}} 次</text>
      </view>
    </view>

    <view class="rpt-parent">
      <text class="rpt-subtitle">给家长看的一句话</text>
      <view class="muted mt-s">{{rpt.parentLine}}</view>
    </view>
  </view>

  <view class="grid-2 mt">
    <view class="kpi"><view class="num">{{mastery}}%</view><view class="label">掌握率（档位≥5）</view></view>
    <view class="kpi"><view class="num">{{streak}}</view><view class="label">连续打卡</view></view>
  </view>
  <view class="grid-2 mt">
    <view class="kpi"><view class="num">{{learned}}</view><view class="label">已学词</view></view>
    <view class="kpi"><view class="num">{{wrongCount}}</view><view class="label">错词个数</view></view>
  </view>

  <view class="card mt">
    <view class="row-between">
      <text class="card-title">近 30 天</text>
      <text class="muted">共 {{heatSum}} 次</text>
    </view>
    <view class="heat">
      <view
        wx:for="{{heat}}"
        wx:key="date"
        class="heat-cell heat-{{item.level}}"
        data-date="{{item.date}}"
        data-count="{{item.count}}"
        bindtap="onHeatTap"
      ></view>
    </view>
  </view>

  <view class="card">
    <view class="row-between">
      <text class="card-title">错词本</text>
      <text class="muted">{{wrongCount}} 个</text>
    </view>
    <view class="muted mt-s">错词在次日、第 3 天、第 7 天强制复现，且换一种题型再考。</view>
    <view wx:if="{{!wrongList.length}}" class="muted mt">暂无错词。去抽查几组，错的词会自动进来。</view>
    <view wx:for="{{wrongList}}" wx:key="word" class="line">
      <view class="col">
        <text class="wrong-word">{{item.word}}</text>
        <text class="muted">{{item.def_cn}}</text>
      </view>
      <view class="col right">
        <text class="badge {{item.hot ? 'hi' : 'lo'}}">错 {{item.wrong_count}} 次</text>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="card-title">复习间隔是怎么定的</text>
    <view class="muted mt-s">「档位」= 这词记牢到什么程度；「间隔」= 下次什么时候再见。两者是分开的。</view>
    <view class="line mt-s"><text>想得很快</text><text class="accent">档位 +2</text></view>
    <view class="line"><text>想起来但费劲</text><text class="accent">档位不变，间隔减半</text></view>
    <view class="line"><text>连续两次费劲</text><text class="accent">按没想起来处理</text></view>
    <view class="line"><text>没想起来</text><text class="accent">档位归零，10 分钟后重来</text></view>
    <view class="muted mt-s">
      为什么"费劲"只减半不降档：承认这词没退步，只是这次状态不好。但连着两次都费劲，说明那个档位本来就虚高了，
      就退回去重学——否则后台会把它算成"已掌握"，而用户每次见它只有点印象，数据就在说谎。
    </view>
  </view>

  <footer-nav active="settings" />
</view>
