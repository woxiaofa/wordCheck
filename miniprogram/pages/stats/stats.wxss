.col { display: flex; flex-direction: column; }
.right { align-items: flex-end; }
.wrong-word { font-size: 30rpx; font-weight: 600; }

.badge {
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}
.badge.hi { background: rgba(255, 92, 114, .18); color: var(--bad-soft2); border: 1rpx solid rgba(255, 92, 114, .4); }
.badge.lo { background: rgba(255, 176, 32, .16); color: var(--gold-soft); border: 1rpx solid rgba(255, 176, 32, .35); }

/* ===== 日报 / 周报 / 月报 ===== */
.rpt-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.rpt-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--muted);
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
}
.rpt-tab.on {
  color: var(--text);
  background: rgba(62, 166, 255, .16);
  border-color: var(--accent);
  font-weight: 600;
}

.rpt-kpis {
  display: flex;
  margin-top: 24rpx;
  border-top: 1rpx solid var(--line);
  padding-top: 24rpx;
}
.rpt-kpi {
  flex: 1;
  text-align: center;
}
.rpt-kpi .n {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.1;
}
.rpt-kpi .l {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}
.rpt-kpi .d {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--muted);
}
.rpt-kpi .d.up { color: var(--ok-text); }
.rpt-kpi .d.down { color: var(--bad-soft2); }

/* 日报：今日构成的堆叠条 */
.rpt-split { margin-top: 28rpx; }
.rpt-split-bar {
  display: flex;
  height: 26rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: var(--surface2);
}
.rpt-split-bar .seg { height: 100%; }
/* 功能色当「填充」用就写死：它们是数据块的形体，跟着皮肤变色反而看不出是同一份数据 */
.seg.known { background: #2fd07a; }
.seg.vague { background: var(--gold-soft); }
.seg.forgot { background: #ff5c72; }
.rpt-legend {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--muted);
}
.legend-item { display: flex; align-items: center; }
.dot {
  /* 作为 legend-item 的直接子节点，宽高才确定生效（原先放在 text 里尺寸不稳） */
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}
.dot.known { background: #2fd07a; }
.dot.vague { background: var(--gold-soft); }
.dot.forgot { background: #ff5c72; }

/* 周/月报：逐日趋势条 */
.rpt-bars {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  margin-top: 28rpx;
}
.rpt-bar { flex: 1; }
/* 月报按周聚合后的桶条：比逐日条宽得多，圆角和字都放大一档 */
.rpt-bar.wk .rpt-bar-track { border-radius: 14rpx; }
.rpt-bar.wk .rpt-bar-day { font-size: 20rpx; font-weight: 600; color: var(--text3); }
.rpt-bar-track {
  height: 180rpx;
  display: flex;
  align-items: flex-end;
  background: var(--surface);
  border-radius: 10rpx;
  overflow: hidden;
}
/* 原来下端是写死的 #1d4f74 深蓝：浅色皮肤下 accent 是粉/橘/绿，
   粉压深蓝看着像配色事故。统一到全站那道「强调色 → 品牌紫」渐变（进度条、确认键同款） */
.rpt-bar-fill {
  width: 100%;
  background: linear-gradient(180deg, var(--accent), #7c5cff);
  border-radius: 10rpx;
}
.rpt-bar-fill.empty { background: var(--surface2); }
.rpt-bar-day {
  display: block;
  margin-top: 8rpx;
  text-align: center;
  font-size: 18rpx;
  color: var(--muted);
}

.rpt-note {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  font-size: 26rpx;
  line-height: 1.6;
}
.rpt-subtitle {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}
.rpt-wrong { margin-top: 28rpx; }
.rpt-wrong-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.rpt-wrong-line:last-child { border-bottom: none; }
.rpt-wrong-mid { display: flex; flex-direction: column; }
.rpt-parent {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

/* 30 天热力图：10 列 × 3 行 */
.heat {
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  gap: 8rpx;
  margin-top: 20rpx;
}
.heat-cell {
  height: 48rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--line);
}
/* 分档配色：0 档 = 空格（跟卡面走），1~4 档是固定的蓝色渐进 ——
   两套深浅皮肤下都可读，不用进 token 表 */
.heat-0 { background: var(--surface2); }
.heat-1 { background: #a8cfe8; }
.heat-2 { background: #6aa8d8; }
.heat-3 { background: #2f86c8; }
.heat-4 { background: #6a4bdb; }
