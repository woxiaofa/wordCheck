.col { display: flex; flex-direction: column; }
.right { align-items: flex-end; }
.wrong-word { font-size: 30rpx; font-weight: 600; }

.badge {
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}
.badge.hi { background: rgba(255, 92, 114, .18); color: #ff8a9b; border: 1rpx solid rgba(255, 92, 114, .4); }
.badge.lo { background: rgba(255, 176, 32, .16); color: #ffc861; border: 1rpx solid rgba(255, 176, 32, .35); }

/* ===== 日报 / 周报 / 月报 ===== */
.rpt-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.rpt-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--muted);
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
}
.rpt-tab.on {
  color: var(--text);
  background: rgba(62, 166, 255, .16);
  border-color: var(--accent);
  font-weight: 600;
}

.rpt-kpis {
  display: flex;
  margin-top: 24rpx;
  border-top: 1rpx solid var(--line);
  padding-top: 24rpx;
}
.rpt-kpi {
  flex: 1;
  text-align: center;
}
.rpt-kpi .n {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.1;
}
.rpt-kpi .l {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}
.rpt-kpi .d {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--muted);
}
.rpt-kpi .d.up { color: #2fd07a; }
.rpt-kpi .d.down { color: #ff8a9b; }

/* 日报：今日构成的堆叠条 */
.rpt-split { margin-top: 28rpx; }
.rpt-split-bar {
  display: flex;
  height: 26rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: var(--surface2);
}
.rpt-split-bar .seg { height: 100%; }
.seg.known { background: #2fd07a; }
.seg.vague { background: #ffc861; }
.seg.forgot { background: #ff5c72; }
.rpt-legend {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--muted);
}
.legend-item { display: flex; align-items: center; }
.dot {
  /* 作为 legend-item 的直接子节点，宽高才确定生效（原先放在 text 里尺寸不稳） */
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}
.dot.known { background: #2fd07a; }
.dot.vague { background: #ffc861; }
.dot.forgot { background: #ff5c72; }

/* 周/月报：逐日趋势条 */
.rpt-bars {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  margin-top: 28rpx;
}
.rpt-bar { flex: 1; }
.rpt-bar-track {
  height: 180rpx;
  display: flex;
  align-items: flex-end;
  background: var(--surface);
  border-radius: 10rpx;
  overflow: hidden;
}
.rpt-bar-fill {
  width: 100%;
  background: linear-gradient(180deg, var(--accent), #1d4f74);
  border-radius: 10rpx;
}
.rpt-bar-fill.empty { background: var(--surface2); }
.rpt-bar-day {
  display: block;
  margin-top: 8rpx;
  text-align: center;
  font-size: 18rpx;
  color: var(--muted);
}

.rpt-note {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  font-size: 26rpx;
  line-height: 1.6;
}
.rpt-subtitle {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}
.rpt-wrong { margin-top: 28rpx; }
.rpt-wrong-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.rpt-wrong-line:last-child { border-bottom: none; }
.rpt-wrong-mid { display: flex; flex-direction: column; }
.rpt-parent {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

/* 30 天热力图：10 列 × 3 行 */
.heat {
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  gap: 8rpx;
  margin-top: 20rpx;
}
.heat-cell {
  height: 48rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--line);
}
