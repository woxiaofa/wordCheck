<!-- 学习页：一屏一张卡，其余交给手势 -->
<view class="page page-study {{layoutWide ? 'wide' : ''}}" style="{{layoutStyle}}">
  <view class="bar row-between">
    <text class="tag-line">{{stageText}}</text>
    <!-- 学完最后一个词后 index 会 +1 越界，钳到 queue.length，避免出现 12/11 -->
    <text class="muted" wx:if="{{queue.length}}">{{index < queue.length ? index + 1 : queue.length}} / {{queue.length}}</text>
  </view>

  <!-- 班级作业模式：让孩子（和家长）随时看到这份作业学到哪了 -->
  <view wx:if="{{assignName}}" class="assign-bar">
    <text class="assign-name">📌 {{assignName}}</text>
    <text class="assign-num {{assignDone >= assignTotal ? 'done' : ''}}">{{assignDone}}/{{assignTotal}}</text>
  </view>

  <view class="progress">
    <view class="progress-inner" style="width:{{progressPct}}%"></view>
  </view>

  <!-- 没有卡片的瞬间（学完一轮）不能占 720rpx，否则"学完了"整块被顶到屏幕外、按钮被 tabBar 盖住 -->
  <view class="content {{word ? 'has-card' : ''}}">
    <word-card
      wx:if="{{word}}"
      id="card"
      card-key="{{cardKey}}"
      word="{{word}}"
      state="{{wordState}}"
      demo="{{isDemo}}"
      locked="{{loading}}"
      reveal-after="{{isDemo ? 0 : 8000}}"
      show-hint="{{!isDemo}}"
      bind:feedback="onFeedback"
      bind:known="onKnown"
      bind:reveal="onReveal"
      bind:speak="onSpeak"
    />

    <!-- 记完评价后的短暂过渡：明确告诉用户"已记录"，同时让换词这件事看得见。
         260ms 的停顿还顺带避免了在同一 tick 里既复位又换数据导致的竞态。 -->
    <view wx:if="{{loading}}" style="margin-top:20rpx;padding:24rpx;border:2rpx solid #2fd07a;border-radius:20rpx;background:#16281d;text-align:center">
      <view style="font-size:30rpx;font-weight:700;color:#2fd07a">已记录 · {{loadingText}}</view>
      <view style="margin-top:8rpx;font-size:24rpx;color:#8fa3b7">正在取出下一个词…</view>
    </view>
  </view>

  <!-- 队列装配中（云端冷启动 1~2 秒）：只给一句中性的等待文案，
       不渲染"学完了"空状态——否则新号第一次打开会先闪一下"再学一轮" -->
  <view class="empty" wx:if="{{!word && queueLoading}}">
    <view class="muted center" style="padding:60rpx 0">正在取出今天的词…</view>
  </view>

  <view class="empty" wx:if="{{!word && !queueLoading}}">
    <view class="empty-emoji">🎉</view>
    <view class="empty-title">{{emptyText}}</view>
    <view class="empty-sub">{{emptySub}}</view>

    <!-- 一轮学完必须去抽查：学习时的点击只是"这次感觉如何"，
         真正决定间隔长短的是抽查结果。不给这个引导，用户会一直只学不查，
         那 SRS 记录的只是他的自我感觉。 -->
    <view wx:if="{{roundDone}}" style="margin-top:32rpx;padding:28rpx;border:2rpx solid #3ea6ff;border-radius:20rpx;background:#152435">
      <view style="font-size:30rpx;font-weight:700;color:#3ea6ff">下一关：抽查</view>
      <view style="margin-top:10rpx;font-size:26rpx;color:#cfe0f0;line-height:1.7">
        抽查里答对的词，才会进入更长的复习间隔（15 天以上）。<br />
        答错的词会回到滚动复习列表，10 分钟后重新出现。
      </view>
      <button class="btn" style="margin-top:22rpx" bindtap="onGoQuiz">开始抽查</button>
    </view>

    <button class="btn ghost mt" bindtap="onRestart">再学一轮</button>

    <!-- 今天确实没词可学：说清原因，并给出一个不破坏计划的出口。
         自动塞词会刷新间隔、打乱 SRS，所以必须由用户主动点。 -->
    <button wx:if="{{canExtra}}" class="btn mt" bindtap="onExtra">提前巩固 10 个词</button>
    <view wx:if="{{canExtra}}" class="muted center mt-s">
      提前复习会刷新这几个词的间隔，等于把复习计划往前拨，不计入今日任务
    </view>
  </view>

  <view class="foot-note">
    {{extraRound ? '提前巩固中：这几个词还没到复习时间，重学会刷新它们的间隔' : '这一轮的顺序系统已排好：先复习快忘的，再看错词，最后学新词'}}
  </view>

  <footer-nav active="study" />
</view>
