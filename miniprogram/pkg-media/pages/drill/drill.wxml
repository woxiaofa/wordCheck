<!--
  快刷页（背词 + 抽查合并后的主流程）
    第 1 步「认」：读音 + 单词 + 音标 → 两个中文释义二选一（另有【不会】诚实按钮）
    第 2 步「写」：读音 + 音标 + 中文 → 自绘键盘拼英文（键盘难度由简单到复杂）
    第 3 步「巩固」：没拿下的词换抽查方式反复测到全对
    完成：时长 + 错题本 + 荣誉/排名 + 分享 + 继续学习 / 下一个任务
  答题中与答错看答案后，喇叭都无限次可点 —— 记单词不看读音频次等于只记一半。
-->
<view class="page drill {{layoutWide ? 'wide' : ''}}" style="{{layoutStyle}}">

  <view class="bar row-between">
    <text class="tag-line">
      <block wx:if="{{assignName}}">📌 {{assignName}}</block>
      <block wx:else>{{stepText}}</block>
    </text>
    <text class="muted">{{state === 'done' ? '完成' : typeLabel}}</text>
  </view>
  <view class="progress">
    <view class="progress-inner" style="width:{{progressPct}}%"></view>
  </view>

  <!-- ============ 答题 ============ -->
  <block wx:if="{{state === 'run' && q}}">
    <view class="card qcard {{judgedOk ? 'flash' : ''}}">
      <!-- 题干：认=显示单词；写=只给中文+音标（单词绝不出现在题面上） -->
      <view class="qword-row" bindtap="onSpeak">
        <text class="qword {{q.type === 'binary' || q.type === 'meaning' ? '' : 'qword-hint'}}">{{q.type === 'listen' ? '🔊 听写' : (q.type === 'spell' ? '✏️ 拼写' : (q.type === 'dictation' ? '✏️ 拼写' : q.wordId))}}</text>
        <text class="speaker" wx:if="{{q.type !== 'spell'}}">🔊</text>
      </view>
      <view class="qph" wx:if="{{q.type !== 'spell'}}">{{q.word.phonetic}}　{{q.word.pos}}</view>
      <view class="qstem" wx:if="{{q.type === 'dictation' || q.type === 'spell'}}">{{q.stem}}</view>

      <!-- 选项/键盘区：贴到卡片底部，视线不用往上够 -->
      <view class="qbody">
        <!-- 选择题：第 1 步两个选项，巩固轮四个 -->
        <block wx:if="{{q.options}}">
          <view
            wx:for="{{q.options}}"
            wx:key="*this"
            class="opt {{pickedIdx === index ? (index === q.answerIdx ? 'right' : 'wrong') : ''}}"
            data-idx="{{index}}"
            bindtap="onPick"
          >{{item}}</view>
        </block>

        <!-- 写：自绘键盘拼英文。难度由简单到复杂，拼错自动降回最简单 -->
        <block wx:else>
          <!-- 已输入区：字母更大更宽松；点某个字母 = 光标移到它前面，可从中间插入 -->
          <view class="typed {{kbText ? 'typed-full' : ''}}" bindtap="onTypedEndTap">
            <block wx:for="{{kbValue}}" wx:key="index">
              <text wx:if="{{index === kbCaret}}" class="caret"></text>
              <text class="tl" data-pos="{{index}}" catchtap="onTypedTap">{{item}}</text>
            </block>
            <text wx:if="{{kbCaret >= kbValue.length}}" class="caret"></text>
          </view>
          <view class="kb-meta" wx:if="{{kbLevelLabel}}">键盘难度：{{kbLevelLabel}}（拼错会自动变简单）</view>
          <letter-keyboard
            class="mt"
            length="{{q.length || 0}}"
            level="{{kbLevel}}"
            word="{{q.wordId || ''}}"
            value="{{kbValue}}"
            caret="{{kbCaret}}"
            confirm-label="确定"
            bind:input="onKeyInput"
            bind:confirm="onKeyConfirm"
          />
        </block>

        <!-- 不会就说不会：只给选项时，不会的孩子只能瞎蒙，蒙对了系统会真当他学会了 -->
        <button class="btn ghost honest" bindtap="onDontKnow">不会，直接看答案</button>

        <view class="slow-hint" wx:if="{{slowHint && pickedIdx < 0 && !q.options}}">
          想不起来也没关系 —— 拼一个试试，看完详情记得更牢
        </view>
        <view class="slow-hint" wx:elif="{{slowHint && pickedIdx < 0}}">
          想了很久？凭第一感觉选，选错会立刻给你看释义
        </view>
      </view>
    </view>

    <view class="muted center mt-s">
      答对了立刻跳下一个词；答错或点「不会」，会先看一眼这个词
    </view>
  </block>

  <!-- ============ 答错 / 不会 / 超时：词详情（引导跟读） ============ -->
  <block wx:if="{{state === 'detail' && detail}}">
    <view class="card detail-card">
      <view class="dflag bad">{{detail.fbLabel}}</view>

      <view class="qword-row" bindtap="onSpeak">
        <text class="qword">{{detail.word.word}}</text>
        <text class="speaker">🔊</text>
      </view>
      <view class="qph">{{detail.word.phonetic}}　{{detail.word.pos}}</view>

      <view class="ddef">{{detail.word.def_cn}}</view>

      <view class="dex" wx:if="{{detail.word.example_en}}">
        <view class="dex-en">{{detail.word.example_en}}</view>
        <view class="dex-cn">{{detail.word.example_cn}}</view>
      </view>

      <view class="dyour" wx:if="{{detail.yourPick}}">
        <text class="dyour-wrong">你{{detail.pickVerb}}的是「{{detail.yourPick}}」</text>
        <text class="dyour-right">{{detail.answerVerb}}「{{detail.answer}}」</text>
      </view>

      <!-- 跟读引导：只看不念记不住，这里明确鼓励多听几遍；整块可点，等于一个更好按的大喇叭 -->
      <view class="read-guide" bindtap="onSpeak">
        <view class="rg-text">🗣 {{detail.guide}}</view>
        <view class="rg-count" wx:if="{{detail.speakCount}}">已跟着念 {{detail.speakCount}} 遍 · 点这里再听一遍 🔊</view>
        <view class="rg-count" wx:else>点这里就能再听一遍 🔊</view>
      </view>

      <view class="detail-bottom">
        <button class="btn ghost" bindtap="onSpeak">🔊 跟着念一遍</button>
        <button class="btn mt-s" bindtap="onDetailNext">下一词</button>
        <view class="muted center mt-s">
          这个词等下还会再考你一次，直到答对为止
        </view>
      </view>
    </view>
  </block>

  <!-- ============ 完成 ============ -->
  <block wx:if="{{state === 'done' && result}}">
    <view class="card center">
      <view class="done-emoji">{{result.allDone ? '🎉' : '👍'}}</view>
      <view class="done-title">{{result.allDone ? '这一轮全部答对' : '这一轮练完了'}}</view>
      <view class="done-sub">
        {{result.assignName ? result.assignName + ' · ' : ''}}用时 {{elapsedText}}，
        {{result.mastered}}/{{result.total}} 个词已拿下
      </view>

      <!-- 荣誉 / 排名：比的是同一个词库或同一份作业 -->
      <view class="honor" wx:if="{{honor && (honor.badge || honor.beat)}}">
        <view class="honor-badge">{{honor.badge}}</view>
        <view class="honor-detail" wx:if="{{honor.detail}}">{{honor.detail}}</view>
        <view class="honor-detail" wx:if="{{honor.beat && honor.total > 1}}">
          你打败了 {{honor.beat}}% 的人（第 {{honor.rank}}/{{honor.total}} 名）
        </view>
        <!-- 今日 / 本周 / 本月最快：每人都留各自周期内的最好成绩 -->
        <view class="hp-list" wx:if="{{honorPeriods.length}}">
          <view class="hp-row" wx:for="{{honorPeriods}}" wx:key="label">
            <text class="hp-label">{{item.label}}</text>
            <text class="hp-value">{{item.text}}</text>
          </view>
        </view>
      </view>

      <view class="kpi-row mt">
        <view class="kpi"><view class="num">{{result.total}}</view><view class="label">本轮词数</view></view>
        <view class="kpi"><view class="num">{{result.mastered}}</view><view class="label">已拿下</view></view>
        <view class="kpi"><view class="num">{{result.wrongBook.length}}</view><view class="label">曾答错</view></view>
      </view>

      <!-- 错题本：答错的词摆出来，家长一眼看得出要盯哪几个 -->
      <view class="wb" wx:if="{{result.wrongBook.length}}">
        <view class="wb-title">错题本（这几个词还要再巩固）</view>
        <view class="wb-list">
          <view class="wb-item" wx:for="{{result.wrongBook}}" wx:key="word">
            <text class="wb-w">{{item.word}}</text>
            <text class="wb-d">{{item.def_cn}}</text>
          </view>
        </view>
      </view>

      <!-- 昵称 / 头像：只在没设置时出现，用于榜单显示（微信不允许静默获取） -->
      <view class="profile-card" wx:if="{{!me.nickname}}">
        <view class="muted" style="font-size:24rpx">
          想在榜单里显示你的名字？设一个昵称和头像（随时可改，不设也不影响练词）
        </view>
        <view class="prow">
          <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <image wx:if="{{me.avatar}}" src="{{me.avatar}}" mode="aspectFill" class="avatar-img" />
            <text wx:else class="avatar-ph">＋</text>
          </button>
          <input class="input grow" type="nickname" value="{{me.nickname}}"
                 placeholder="点这里填昵称" maxlength="16" bindblur="onNicknameInput" />
        </view>
      </view>

      <button class="btn mt" bindtap="onAgain">
        {{result.left.length ? '再练一轮 · 剩 ' + result.left.length + ' 词' : '再来一轮'}}
      </button>
      <button class="btn ghost mt-s" open-type="share">分享这个成绩</button>
      <button class="btn ghost mt-s" bindtap="onNextTask">下一个任务</button>
      <button class="btn ghost mt-s" wx:if="{{result.wrongBook.length}}" bindtap="onWrongBook">看错词本</button>
    </view>
  </block>

  <!-- ============ 没有词 ============ -->
  <block wx:if="{{state === 'empty' || state === 'loading'}}">
    <view class="card center">
      <view class="muted" style="padding:60rpx 0">
        {{state === 'loading' ? '正在取出今天要练的词…' : '今天没有要练的词了，明天再来 🎉'}}
      </view>
      <button class="btn ghost mt" wx:if="{{state === 'empty'}}" bindtap="onHome">回首页</button>
    </view>
  </block>

  <footer-nav active="study" />
</view>
