/* 快刷页样式：一屏一件事——看清词、选意思、看结果 */

.drill .bar { margin-bottom: 12rpx; }
.tag-line { font-size: 26rpx; color: var(--muted); }

/* 题目卡：一屏一题 —— 词在上方大字展示，选项贴底（拇指够得着） */
.qcard {
  display: flex;
  flex-direction: column;
  /* 扣掉顶栏+进度条+底部导航，让卡片基本占满一屏 */
  min-height: calc(100vh - 400rpx);
  box-sizing: border-box;
  padding: 40rpx 28rpx;
}
.qword-row { display: flex; align-items: center; justify-content: center; }
.qword {
  font-size: 100rpx; font-weight: 800; letter-spacing: 2rpx;
  color: var(--text); word-break: break-all; text-align: center;
}
.speaker { font-size: 44rpx; margin-left: 16rpx; opacity: .75; }
/* 拼写/听写题没有大字单词，顶部提示用小一号 */
.qword-hint { font-size: 48rpx; letter-spacing: 0; color: var(--muted); }
.qph { text-align: center; color: var(--muted); font-size: 28rpx; margin-top: 8rpx; }
.qstem { text-align: center; font-size: 34rpx; margin-top: 20rpx; }

/* 情景填句：给中文 + 场景，把句子里的词挖空（句子级考查，对应真听写） */
.cloze {
  margin-top: 18rpx;
  padding: 24rpx 22rpx;
  background: var(--fill);
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  text-align: center;
}
.cloze-pic { font-size: 76rpx; line-height: 1.1; }
.cloze-cn { margin-top: 10rpx; font-size: 30rpx; color: #c8d4e0; }
.cloze-en {
  margin-top: 16rpx;
  font-size: 34rpx;
  line-height: 1.7;
  color: var(--text2);
  font-weight: 600;
  word-break: break-word;
}
.cloze-blank {
  display: inline-block;
  min-width: 120rpx;
  margin: 0 6rpx;
  padding: 0 10rpx;
  border-bottom: 4rpx solid var(--muted5);
  color: var(--muted5);
}
.cloze-blank.filled { border-bottom-color: #2fd07a; color: #2fd07a; }

/* 选项/键盘区：推到卡片底部 */
.qbody { margin-top: auto; }

/* 选项：首轮两个、循环轮四个，都是大块，好点 */
.opt {
  margin-top: 20rpx;
  padding: 30rpx 26rpx;
  background: var(--surface2);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  font-size: 32rpx;
  line-height: 1.5;
  text-align: center;
}
.opt:active { background: #24344a; }
.opt.right { border-color: #2fd07a; background: #17324a; }
.opt.wrong { border-color: #ff5c72; background: #3a1f2a; }

/* 拼写/听写输入区 */
/* 已输入区：字母加大加间距（孩子要盯着的主体），字母可点=把光标放到它前面 */
.typed {
  margin-top: 24rpx;
  min-height: 96rpx;
  display: flex; align-items: center; justify-content: center;
  flex-wrap: wrap;
  padding: 8rpx 12rpx;
  color: var(--accent);
  background: var(--fill); border-radius: 16rpx; border: 2rpx dashed var(--line);
}
.typed .tl {
  font-size: 56rpx; font-weight: 700;
  padding: 0 8rpx; line-height: 1.2;
}
/* 短语里的空格/连字符（2026-10-10 收录短语）：空格敲出来是看不见的，
   给个明确的宽度让它"占住位置"；连字符颜色淡一点，和字母区分 */
.typed .tl-space { min-width: 40rpx; padding: 0; }
.typed .tl-hyphen { color: var(--muted); }
.typed-full { border-style: solid; color: var(--text); }
.typed-full .tl { color: var(--text); }
.typed-full .tl-hyphen { color: var(--muted); }

/* 插入光标：一条竖线，标出"下一个字母从哪里插进去" */
.caret {
  display: inline-block;
  width: 6rpx; height: 56rpx;
  margin: 0 4rpx;
  border-radius: 3rpx;
  background: var(--accent);
  animation: caret-blink 1s step-end infinite;
}
@keyframes caret-blink { 50% { opacity: 0; } }

/* 答对后短暂的高亮：让"换词"看得见 */
.qcard.flash { border-color: #2fd07a; }

/* 答对庆祝层（#36，2026-10-10）：全屏轻遮罩 + 中央 ✓ 缩放弹跳 + "答对了！"。
   与音效同步停 ~1 秒，孩子确定"这题过了"再进下一题。 */
.celebrate {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(10, 16, 24, 0.45);
  z-index: 90;
  pointer-events: none;
  animation: celebrate-fade 0.55s ease forwards;
}
.celebrate-pop {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2fd07a, #1fa860);
  box-shadow: 0 12rpx 48rpx rgba(47, 208, 122, 0.45);
  color: #ffffff;
  font-size: 110rpx;
  font-weight: 700;
  animation: celebrate-pop 0.45s cubic-bezier(0.2, 1.6, 0.4, 1) forwards;
}
.celebrate-text {
  margin-top: 24rpx;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 600;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.4);
  animation: celebrate-rise 0.5s 0.1s ease both;
}
@keyframes celebrate-pop {
  0% { transform: scale(0); opacity: 0; }
  60% { transform: scale(1.15); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}
@keyframes celebrate-rise {
  0% { transform: translateY(20rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}
@keyframes celebrate-fade {
  0%, 80% { opacity: 1; }
  100% { opacity: 0.9; }
}

.slow-hint {
  margin-top: 20rpx; text-align: center;
  font-size: 24rpx; color: #ffb020;
}

/* 详情（答错/超时后看一眼这个词）：卡片充满一屏，按钮钉底 */
.detail-card {
  display: flex;
  flex-direction: column;
  min-height: calc(100vh - 400rpx);
  box-sizing: border-box;
  padding: 36rpx 28rpx;
}
.detail-bottom { margin-top: auto; }
.dflag {
  display: inline-block; padding: 6rpx 16rpx; border-radius: 99rpx;
  font-size: 24rpx; background: #3a1f2a; color: #ff8a9c; margin-bottom: 20rpx;
  align-self: flex-start;
}
.ddef {
  margin-top: 20rpx; text-align: center;
  font-size: 44rpx; font-weight: 600; color: var(--accent);
}
.dex { margin-top: 24rpx; padding: 22rpx; background: var(--fill); border-radius: 16rpx; }
.dex-en { font-size: 30rpx; line-height: 1.6; }
.dex-cn { margin-top: 6rpx; font-size: 26rpx; color: var(--muted); line-height: 1.6; }
.dyour {
  margin-top: 20rpx; padding: 18rpx 22rpx;
  background: var(--fill); border-radius: 16rpx;
  display: flex; flex-direction: column; gap: 8rpx;
}
/* 详情页两个练习按钮并排：念一遍 / 抄一遍 —— 耳朵和手都要走一遍 */
.dbtn-row { display: flex; gap: 16rpx; }
.dbtn-row .btn { flex: 1; min-width: 0; }

/* 抄写区：照着词拼一遍，可以抄好几遍 */
.copy-box {
  margin-top: 24rpx; padding: 22rpx;
  background: var(--fill); border-radius: 16rpx;
  /* 2026-10-10 用户反馈：去掉左侧橙色竖条 —— 抄写区里装了全宽键盘后，
     这条边框跟着盒子一起被拉到整个键盘的高度，看着像一根突兀的长棍 */
}
.copy-title { font-size: 26rpx; color: var(--text3); margin-bottom: 8rpx; }
/* 抄写时的悬浮词条：钉在屏幕顶部，页面再长也不会划走（position:fixed） */
.copy-pin {
  position: fixed; left: 0; right: 0; top: 0; z-index: 50;
  display: flex; align-items: center;
  padding: 18rpx 24rpx;
  background: var(--bg2);
  border-bottom: 1rpx solid var(--line);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, .35);
}
.pin-word {
  flex: 1; min-width: 0;
  display: flex; align-items: baseline; flex-wrap: wrap;
}
.pin-text { font-size: 44rpx; font-weight: 700; color: var(--accent); letter-spacing: 2rpx; }
.pin-ph { margin-left: 14rpx; font-size: 24rpx; color: var(--muted); }
.pin-mask { font-size: 40rpx; font-weight: 700; color: #5b7387; letter-spacing: 10rpx; }
.pin-tip { margin-left: 14rpx; font-size: 22rpx; color: var(--muted); }
.pin-toggle {
  flex-shrink: 0;
  padding: 12rpx 20rpx; margin-left: 16rpx;
  font-size: 25rpx; color: var(--text3);
  background: var(--surface3); border: 1rpx solid var(--line); border-radius: 999rpx;
}
.pin-toggle:active { background: var(--active); }
/* 悬浮条占位：不给页面让出高度，顶部的进度条会被盖住 */
.drill.pinned { padding-top: 120rpx; }

/* 输入框为空时的占位：抄完清空后不至于是一片空白，不知道下一步干嘛 */
.typed-ph { font-size: 26rpx; color: #5b6b7d; margin-left: 8rpx; }
.copy-msg { margin-top: 12rpx; font-size: 25rpx; line-height: 1.5; }
.copy-msg.ok { color: #2fd07a; }
.copy-msg.bad { color: #ff8a9c; }

.dyour-wrong { font-size: 26rpx; color: #ff8a9c; }
.dyour-right { font-size: 28rpx; color: #2fd07a; font-weight: 600; }

/* 宽屏（iPad / 折叠展开 / PC）：rpx 会被放大，收回 px 比例 */
.wide .qcard, .wide .detail-card { min-height: calc(100vh - 260px); padding: 20px; }
.wide .qword { font-size: 48px; }
.wide .speaker { font-size: 22px; }
.wide .qph { font-size: 14px; }
.wide .qstem { font-size: 17px; }
.wide .opt { padding: 15px 13px; font-size: 16px; border-radius: 10px; margin-top: 10px; }
.wide .dflag { font-size: 12px; padding: 3px 8px; }
.wide .ddef { font-size: 22px; }
.wide .dex-en { font-size: 15px; }
.wide .dex-cn { font-size: 13px; }
.wide .dyour { font-size: 13px; padding: 10px; gap: 4px; }
.wide .rg-count { font-size: 11px; }
.wide .copy-box { padding: 12px; margin-top: 12px; }
.wide .copy-pin { padding: 10px 16px; }
.wide .pin-text { font-size: 24px; }
.wide .pin-ph { font-size: 12px; }
.wide .pin-mask { font-size: 22px; letter-spacing: 5px; }
.wide .pin-tip { font-size: 11px; }
.wide .pin-toggle { font-size: 13px; padding: 6px 12px; }
.wide.drill.pinned { padding-top: 64px; }
.wide .copy-title { font-size: 13px; }
.wide .typed-ph { font-size: 13px; }
.wide .copy-msg { font-size: 13px; }
.wide .dbtn-row { gap: 8px; }
.wide .hp-label, .wide .hp-value { font-size: 12px; }

/* 完成态 */
.done-emoji { font-size: 88rpx; }
.done-title { font-size: 40rpx; font-weight: 700; margin-top: 8rpx; }
.done-sub { margin-top: 10rpx; font-size: 28rpx; color: var(--muted); }
.kpi-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }

/* 错题本 */
.wb { margin-top: 28rpx; text-align: left; }
.wb-title { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.wb-list { display: flex; flex-wrap: wrap; }
.wb-item {
  width: 100%;
  display: flex; align-items: baseline;
  padding: 12rpx 0; border-bottom: 1rpx dashed var(--line);
}
.wb-w { font-size: 30rpx; font-weight: 600; width: 240rpx; }
.wb-d { font-size: 26rpx; color: var(--muted); flex: 1; }

/* 「不会」诚实按钮：次要但不隐藏 —— 不会就该有地方说，而不是逼着瞎蒙 */
.honest {
  margin-top: 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  color: var(--muted);
  background: transparent;
  border: 2rpx dashed var(--active);
  border-radius: 16rpx;
}
.honest::after { border: none; }

/* 键盘难度说明：让家长知道"变简单"是设计，不是坏了 */

/* 详情页跟读引导：只看不念记不住，这里明确鼓励多听几遍；整块可点（大喇叭） */
.read-guide {
  margin-top: 24rpx; padding: 20rpx 22rpx;
  background: var(--fill); border-radius: 16rpx;
  border-left: 6rpx solid var(--accent);
}
.read-guide:active { background: #1b2836; }
.rg-text { font-size: 28rpx; color: var(--text3); line-height: 1.6; }
.rg-count { margin-top: 8rpx; font-size: 22rpx; color: var(--accent); }

/* 荣誉 / 排名 */
.honor {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #3a2f10, #2a2a1c);
  border: 2rpx solid #7a6320;
}
.honor-badge { font-size: 34rpx; font-weight: 700; color: #ffd166; }
.honor-detail { font-size: 22rpx; color: #c9b98a; margin-top: 6rpx; }

/* 今日 / 本周 / 本月最快：三行小榜，榜首是我时值直接写"就是你" */
.hp-list { margin-top: 14rpx; border-top: 1rpx dashed #574a1e; padding-top: 10rpx; }
.hp-row {
  display: flex; align-items: baseline; justify-content: space-between;
  padding: 8rpx 0;
}
.hp-label { font-size: 24rpx; color: #c9b98a; }
.hp-value { font-size: 24rpx; color: #ffd166; font-weight: 600; }

/* 昵称 / 头像（榜单展示用，用户自愿填） */
.profile-card {
  margin-top: 24rpx; padding: 20rpx;
  background: var(--fill); border-radius: 16rpx; text-align: left;
}
.prow { display: flex; align-items: center; margin-top: 16rpx; }
/* 头像按钮：宽高必须 !important —— 微信给原生 button 注入的
   wx-button { width:184px } 选择器优先级更高，会把 96rpx 盖掉，
   96rpx 高 × 184px 宽就拉成了椭圆（2026-10-07 实锤） */
.avatar-btn {
  width: 96rpx !important; height: 96rpx !important;
  min-width: 0 !important; padding: 0 !important; margin: 0 !important;
  border-radius: 50%; overflow: hidden;
  background: var(--surface3); border: 2rpx solid var(--active);
  display: flex; align-items: center; justify-content: center;
}
.avatar-btn::after { border: none; }
.avatar-img { width: 96rpx; height: 96rpx; }
.avatar-ph { font-size: 40rpx; color: var(--muted); }

/* 宽屏：rpx 放大后收回 px */
.wide .honest { margin-top: 12px; height: 38px; line-height: 38px; font-size: 13px; }
.wide .read-guide { padding: 12px; }
.wide .rg-text { font-size: 15px; }
.wide .honor { padding: 12px; }
.wide .honor-badge { font-size: 18px; }
.wide .avatar-btn { width: 52px !important; height: 52px !important; min-width: 0 !important; }
.wide .avatar-img { width: 52px; height: 52px; }

/* 离线练习条：断网照练不误，这里只负责把"数据去哪了"说明白 */
.offline-bar {
  margin-top: 10rpx;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  background: #2e2416;
  border: 1rpx solid #5a4520;
  color: #ffb020;
  font-size: 22rpx;
}

/* iPad 横屏提示（utils/fit.js 检测） */
.rotate-tip {
  background: #FFF7E6;
  color: #8A6116;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  text-align: center;
}
