<view class="page {{skin}}">
  <view class="card" wx:if="{{!id}}">
    <view class="empty">{{toast}}</view>
    <button class="btn ghost mt" bindtap="goBack">返回</button>
  </view>

  <block wx:if="{{id}}">
    <!-- ① 识别：小缩略图 + 状态 + 两个轻操作。照片不再占一整屏，进来就能看到词 -->
    <view class="card">
      <view class="head">
        <view class="shot-wrap" bindtap="preview">
          <image
            wx:if="{{img && !imgBroken}}"
            class="shot"
            src="{{img}}"
            mode="aspectFill"
            binderror="onImgError"
          />
          <view wx:else class="shot broken-mini" bindtap="retake">照片没了，点重拍</view>
          <view class="shot-mask">点看大图</view>
        </view>
        <view class="head-main">
          <view class="head-title">{{recognizing ? '正在认字…' : '识别结果'}}</view>
          <view class="pills" wx:if="{{words.length}}">
            <text class="pill">已认 {{words.length}}</text>
            <text class="pill pill-bad" wx:if="{{badCount}}">{{badCount}} 个待改</text>
          </view>
          <view class="ocr-bar" wx:if="{{recognizing}}">
            <text class="spin"></text>
            <text class="ocr-hint">一般 3~8 秒，别退出</text>
          </view>
          <view class="note {{ocrNote ? 'warn' : 'muted'}}" wx:if="{{ocrNote || words.length}}">{{ocrNote || '点照片放大对着核对'}}</view>
          <view class="head-btns">
            <button class="mini-btn" bindtap="retake" disabled="{{recognizing}}">重拍</button>
            <button class="mini-btn" bindtap="doOcr" disabled="{{recognizing || !img}}">重新识别</button>
          </view>
        </view>
      </view>
    </view>

    <!-- ② 核对：红词提示放最上面，一进来/一点保存就能看见 -->
    <view class="card" wx:if="{{words.length}}">
      <view class="row-between">
        <text class="t1">核对一下（{{words.length}}）</text>
        <text class="muted">点格子直接改</text>
      </view>
      <view class="warn mt-s" wx:if="{{badCount}}">红底的 {{badCount}} 个不像英文单词，改好或删掉才能存成词库。</view>
      <view class="warn mt-s" wx:if="{{toast}}">{{toast}}</view>

      <view class="list mt-s">
        <view
          class="wrow {{item.bad ? 'bad-row' : ''}} {{item.flash ? 'flash' : ''}}"
          wx:for="{{words}}"
          wx:key="_k"
          id="row-{{index}}"
        >
          <input
            class="cell ew {{item.bad ? 'bad' : ''}}"
            value="{{item.word}}"
            data-i="{{index}}"
            bindinput="onEditWord"
            maxlength="30"
          />
          <input
            class="cell ed"
            value="{{item.def_cn}}"
            placeholder="释义"
            placeholder-class="ph"
            data-i="{{index}}"
            bindinput="onEditDef"
            maxlength="20"
          />
          <text class="del" data-i="{{index}}" bindtap="removeWord">✕</text>
        </view>
      </view>
      <view class="muted mt-s hint-line">英文一般认得准，中文释义常被认成符号，照着照片改；不要的点 ✕ 删。</view>
    </view>

    <!-- ③ 漏了的补一个 -->
    <view class="card">
      <view class="row-between">
        <text class="t1">漏了的补一个</text>
        <text class="muted">识别没认出来的</text>
      </view>
      <view class="row mt">
        <input
          class="inp w"
          placeholder="英文"
          value="{{w}}"
          bindinput="onW"
          focus="{{focusW}}"
          maxlength="30"
        />
        <input
          class="inp d"
          placeholder="中文（可空）"
          value="{{d}}"
          bindinput="onD"
          bindconfirm="addWord"
          maxlength="20"
        />
      </view>
      <button class="btn mt {{w ? '' : 'ghost'}}" bindtap="addWord">加进列表</button>
    </view>

    <!-- ④ 起名 + 内容流里的保存入口（不依赖 fixed，绝对点得到） -->
    <view class="card" wx:if="{{words.length}}">
      <input
        class="inp"
        placeholder="词库名（不填就按日期起）"
        value="{{name}}"
        bindinput="onName"
        maxlength="12"
      />
      <button class="btn mt" bindtap="finish">存成我的词库（{{words.length}}）</button>
      <button class="btn ghost mt-s" bindtap="saveLater">先存着，回头再改</button>
    </view>

    <!-- 底部固定操作条：人在页面中间时也能存。
         主按钮占满整行，别留右下角给系统悬浮球（"转发截图"会压住按钮导致点不到）。
         点击后按钮自报状态（barHint），能确认这一下到底有没有点到。 -->
    <!-- 运行版本号：截图里能看到，避免"改了半天其实跑的是旧版" -->
    <view class="ver" wx:if="{{ver}}">v{{ver}}</view>

    <view class="bottom-bar" wx:if="{{words.length}}">
      <view class="bar-sub" bindtap="saveLater">先存着，回头再改</view>
      <button class="bar-btn primary" bindtap="finish">{{barHint || ('存成我的词库（' + words.length + '）')}}</button>
    </view>
  </block>
</view>
