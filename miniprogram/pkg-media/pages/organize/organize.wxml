<view class="page">
  <view class="card" wx:if="{{!id}}">
    <view class="empty">{{toast}}</view>
    <button class="btn ghost mt" bindtap="goBack">返回</button>
  </view>

  <block wx:if="{{id}}">
    <view class="card">
      <view class="row-between">
        <text class="t1">{{recognizing ? '正在认字…' : '识别结果'}}</text>
        <text class="muted" wx:if="{{words.length}}">已认 {{words.length}} 个</text>
      </view>

      <view class="ocr-bar" wx:if="{{recognizing}}">
        <text class="spin"></text>
        <text class="muted">照片发去识别，一般 3~8 秒，别退出</text>
      </view>

      <image
        wx:if="{{img && !imgBroken}}"
        class="shot"
        src="{{img}}"
        mode="widthFix"
        bindtap="preview"
        binderror="onImgError"
      />
      <view wx:else class="broken" bindtap="retake">照片打不开了，点这里重拍一张</view>

      <view class="warn mt-s" wx:if="{{ocrNote}}">{{ocrNote}}</view>
      <view class="muted mt-s" wx:else>点照片可以放大对着核对；拍糊了重拍一张，会自动重认。</view>

      <button class="btn ghost mt" bindtap="retake" disabled="{{recognizing}}">重拍 / 换一张</button>
      <button
        class="btn ghost mt-s"
        bindtap="doOcr"
        disabled="{{recognizing || !img}}"
      >{{words.length ? '重新识别这一张' : '识别这一张'}}</button>
    </view>

    <view class="card" wx:if="{{words.length}}">
      <view class="row-between">
        <text class="t1">核对一下（{{words.length}}）</text>
        <text class="muted">点格子直接改</text>
      </view>
      <view class="muted mt-s" style="line-height:1.7">
        英文基本认得准，中文释义经常认成符号，照着照片改一下就行；不要的删掉。
      </view>

      <view class="pv" wx:for="{{words}}" wx:key="_k">
        <view class="row">
          <input
            class="inp ew {{item.bad ? 'bad' : ''}}"
            value="{{item.word}}"
            data-i="{{index}}"
            bindinput="onEditWord"
            maxlength="30"
          />
          <input
            class="inp ed"
            value="{{item.def_cn}}"
            placeholder="释义（可空）"
            data-i="{{index}}"
            bindinput="onEditDef"
            maxlength="20"
          />
          <text class="del" data-i="{{index}}" bindtap="removeWord">删</text>
        </view>
      </view>

      <view class="warn mt-s" wx:if="{{badCount}}">红框的 {{badCount}} 个不像英文单词，改一下或删掉才能存。</view>
      <view class="warn mt-s" wx:if="{{toast}}">{{toast}}</view>
    </view>

    <view class="card">
      <view class="row-between">
        <text class="t1">漏了的补一个</text>
        <text class="muted">识别没认出来的</text>
      </view>
      <view class="row mt">
        <input
          class="inp w"
          placeholder="英文"
          value="{{w}}"
          bindinput="onW"
          focus="{{focusW}}"
          maxlength="30"
        />
        <input
          class="inp d"
          placeholder="中文（可空）"
          value="{{d}}"
          bindinput="onD"
          bindconfirm="addWord"
          maxlength="20"
        />
      </view>
      <button class="btn mt {{w ? '' : 'ghost'}}" bindtap="addWord">加一个（回车也行）</button>
    </view>

    <view class="card" wx:if="{{words.length}}">
      <input
        class="inp"
        placeholder="给这本词库起个名（如：Unit 5 单词）"
        value="{{name}}"
        bindinput="onName"
        maxlength="12"
      />
      <button class="btn mt" bindtap="finish">存成我的词库</button>
      <button class="btn ghost mt" bindtap="saveLater">先存着，回头再改</button>
    </view>
  </block>
</view>
