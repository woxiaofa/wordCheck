<view class="page">
  <view class="card" wx:if="{{!id}}">
    <view class="empty">{{toast}}</view>
    <button class="btn ghost mt" bindtap="goBack">返回</button>
  </view>

  <block wx:if="{{id}}">
    <view class="card">
      <view class="row-between">
        <text class="t1">对着照片录</text>
        <text class="muted">已录 {{words.length}} 个</text>
      </view>
      <image
        wx:if="{{img && !imgBroken}}"
        class="shot"
        src="{{img}}"
        mode="widthFix"
        bindtap="preview"
        binderror="onImgError"
      />
      <view wx:else class="broken" bindtap="retake">照片打不开了，点这里重拍一张</view>
      <view class="muted mt-s">点照片可以放大慢慢看；拍糊了就重拍一张。</view>
      <button class="btn ghost mt" bindtap="retake">重拍 / 换一张</button>
    </view>

    <view class="card">
      <view class="muted" style="line-height:1.7">
        看着上面的照片，一个词一行地录。中文可以不填，照样能拼能听写。
        录一半退出也没事 —— 已经存好了，回来接着录。
      </view>
      <view class="row mt">
        <input
          class="inp w"
          placeholder="英文"
          value="{{w}}"
          bindinput="onW"
          focus="{{focusW}}"
          maxlength="30"
        />
        <input
          class="inp d"
          placeholder="中文（可空）"
          value="{{d}}"
          bindinput="onD"
          bindconfirm="addWord"
          maxlength="20"
        />
      </view>
      <button class="btn mt {{w ? '' : 'ghost'}}" bindtap="addWord">加一个（回车也行）</button>
      <view class="warn mt-s" wx:if="{{toast}}">{{toast}}</view>
    </view>

    <view class="card" wx:if="{{words.length}}">
      <view class="row-between">
        <text class="t1">已录 {{words.length}} 个</text>
        <text class="muted">点右边删掉录错的</text>
      </view>
      <view class="row-between pv" wx:for="{{words}}" wx:key="word">
        <view class="pv-left"><text class="pv-w">{{item.word}}</text> <text class="muted">{{item.def_cn}}</text></view>
        <text class="del" data-i="{{index}}" bindtap="removeWord">删除</text>
      </view>
    </view>

    <view class="card" wx:if="{{words.length}}">
      <input
        class="inp"
        placeholder="给这本词库起个名（如：Unit 5 单词）"
        value="{{name}}"
        bindinput="onName"
        maxlength="12"
      />
      <button class="btn mt" bindtap="finish">存成我的词库</button>
      <button class="btn ghost mt" bindtap="saveLater">先存着，回头再录</button>
    </view>
  </block>
</view>
