.page { padding: 24rpx 24rpx 230rpx; background: var(--bg); min-height: 100vh; }
.t1 { font-size: 32rpx; font-weight: 700; color: var(--text2); }
.muted { color: var(--muted2); font-size: 26rpx; }
.warn {
  line-height: 1.6;
  color: var(--warn-text);
  font-size: 26rpx;
}
.empty { text-align: center; color: var(--muted2); font-size: 28rpx; padding: 40rpx 0; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.row { display: flex; align-items: center; }
.mt { margin-top: 20rpx; }
.mt-s { margin-top: 12rpx; }

/* ---------- ① 识别头：缩略图 + 状态 ---------- */
.head { display: flex; align-items: flex-start; }
.shot-wrap {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--fill);
}
.shot { width: 100%; height: 100%; }
/* 底部一条半透明字：告诉用户照片还能点开放大 */
.shot-mask {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  padding: 6rpx 0;
  text-align: center;
  font-size: 20rpx;
  color: var(--text3);
  background: rgba(15, 22, 32, .55);
}
.broken-mini {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted2);
  font-size: 24rpx;
  border: 2rpx dashed var(--line);
  box-sizing: border-box;
}
.head-main { flex: 1; min-width: 0; margin-left: 20rpx; }
.head-title { font-size: 32rpx; font-weight: 700; color: var(--text2); }
.pills { margin-top: 12rpx; display: flex; }
.pill {
  font-size: 22rpx;
  color: var(--accent-soft);
  background: rgba(64, 158, 255, .12);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  margin-right: 12rpx;
}
.pill-bad { color: var(--bad-soft); background: rgba(255, 92, 108, .12); }
.note {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  /* 认错原因有时是一长串：最多两行，全文点照片后核对时看 */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.head-btns { margin-top: 14rpx; display: flex; }
.mini-btn {
  margin: 0 16rpx 0 0;
  padding: 0 26rpx;
  height: 58rpx;
  line-height: 58rpx;
  font-size: 24rpx;
  color: var(--text3);
  background: var(--panel);
  border-radius: 12rpx;
}
.mini-btn::after { border: none; }
.mini-btn[disabled] { opacity: .4; }

.ocr-bar { display: flex; align-items: center; margin-top: 12rpx; }
.spin {
  width: 16rpx;
  height: 16rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(64, 158, 255, .25);
  border-top-color: var(--accent);
  animation: spin .7s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.ocr-hint { color: var(--muted2); font-size: 24rpx; }

/* ---------- ② 核对列表：行有底色的 ghost 输入框 ---------- */
.list { margin-top: 8rpx; }
.wrow {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  margin-top: 8rpx;
  /* 行给一层底色：纯 ghost 框悬空着，两列文字像散落的，中英文的边界看不出来 */
  background: var(--fill3);
}
/* 不像英文的整行淡红：一眼扫到在哪，不用盯着边框找 */
.wrow.bad-row { background: rgba(255, 92, 108, .10); }
/* 点"存成词库"被拦时，滚到第一个坏词再闪一下黄光 —— 不然用户以为按钮坏了 */
.wrow.flash { animation: flash 1.6s ease; }
@keyframes flash {
  0%, 55% { background: rgba(255, 193, 7, .30); }
  100% { background: rgba(255, 92, 108, .10); }
}
/* 表格式编辑用 ghost 框（只有一条底线），和"补一个/名称"的方框区分开 */
.cell {
  /* 显式高度 + 行高：只靠 padding 撑高时，真机上中文会被垂直裁掉半行（2026-10-21 反馈） */
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  background: transparent;
  border-bottom: 2rpx solid var(--line6);
  border-radius: 0;
  color: var(--text2);
  font-size: 28rpx;
  /* 显式声明：不指望继承，真机上吃过没对齐的亏 */
  text-align: left;
}
/* 英文列按教材单词长度够用即可，把宽度让给中文释义 —— 中文才是经常被认错、需要改的那一列 */
.ew { flex: 1; min-width: 0; font-weight: 600; }
.ed { flex: 1.55; min-width: 0; margin-left: 14rpx; font-size: 26rpx; }
.ph { color: var(--muted5); font-size: 26rpx; }
.cell.bad { border-bottom-color: #ff5c72; color: var(--bad-soft2); }
.del {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  margin-left: 8rpx;
  color: var(--muted4);
  font-size: 30rpx;
  flex-shrink: 0;
}
.hint-line { line-height: 1.6; }

/* ---------- 表单输入（补一个 / 名称）：保留方框，高度和底栏按钮一致 ---------- */
.inp {
  height: 84rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: var(--fill);
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  color: var(--text2);
  font-size: 28rpx;
  text-align: left;
}
.inp.w { width: 300rpx; }
.inp.d { flex: 1; margin-left: 16rpx; }

/* ---------- 底部固定操作条 ---------- */
/* z-index 必须显式给：漏了它真机上列表内容会滚到按钮上面，视觉穿透 + 点击被吃掉
   （2026-10-21 真机实锤 —— "点存成词库没反应"的根因就是这个，不是逻辑没跑） */
.bottom-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 999;
  padding: 12rpx 24rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  /* 不透明底：半透明会让下面的词透出来，看着也像层级错了 */
  background: var(--bg);
  border-top: 1rpx solid var(--line);   /* 0.08 透明度的白线在浅色皮肤下等于看不见 */
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, .35);
}
.bar-btn {
  display: block;
  width: 100% !important;
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  font-size: 30rpx;
  border-radius: 16rpx;
  color: #fff;
  background: linear-gradient(135deg, #2fd07a, #22a862);
  /* button 自己成为可点层：不给 position，个别机型上 fixed 容器里的 button 会"看得见点不着" */
  position: relative;
  z-index: 1;
}
.bar-btn::after { border: none; }
.bar-sub {
  padding: 4rpx 0 12rpx;
  text-align: center;
  color: var(--muted2);
  font-size: 24rpx;
}

/* 版本号：极小极淡，只为截图排查用，不打扰阅读 */
.ver {
  padding: 8rpx 0 0;
  text-align: center;
  color: var(--muted5);
  font-size: 20rpx;
}
