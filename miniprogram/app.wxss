/* 全局样式 —— 深色底、卡片式，与已确认的 H5 Demo 保持一致的视觉语言 */

page {
  background: #0f1620;
  color: #e8eef5;
  font-size: 30rpx;
  line-height: 1.55;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* 通用容器。
   底部 padding = footer-nav(fixed) 的高度 + 安全区，否则最后一屏的按钮会被 tabBar 盖住。 */
.page { padding: 24rpx 24rpx calc(170rpx + env(safe-area-inset-bottom)); }
.card {
  background: #18222e;
  border: 1rpx solid #2b3949;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.card-title { font-size: 32rpx; font-weight: 600; }

/* 文字层级 */
.t1 { font-size: 34rpx; font-weight: 700; }
.t2 { font-size: 26rpx; color: #8fa3b7; }
.muted { color: #8fa3b7; font-size: 26rpx; }
.dim { color: #8fa3b7; }
.accent { color: #3ea6ff; }
.ok { color: #2fd07a; }
.warn { color: #ffb020; }
.bad { color: #ff5c72; }

/* 布局 */
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20rpx; }
.mt { margin-top: 24rpx; }
.mt-s { margin-top: 12rpx; }

/* 按钮。white-space:nowrap：按钮文案换行（"去抽查 · 10 题，交卷才判分"那种两行）非常难看，
   文案统一控制在一行内，超长就改文案而不是让它折行。
   width:100% 必须显式给：原生 button 在部分环境（Pad/PC 宽屏）默认宽度不是撑满，
   会缩成一小条贴在卡片右边（2026-10-07 iPad Pro 实锤"开始背单词"按钮被裁）。 */
.btn {
  display: flex; align-items: center; justify-content: center;
  width: 100%; box-sizing: border-box; padding: 0; margin-left: 0; margin-right: 0;
  height: 96rpx; border-radius: 24rpx; font-size: 32rpx; font-weight: 600;
  color: #ffffff; background: linear-gradient(135deg, #3ea6ff, #7c5cff);
  border: none; white-space: nowrap;
}
.btn::after { border: none; }
.btn.ghost {
  background: transparent; border: 1rpx solid #2b3949; color: #e8eef5;
}
.btn.ok { background: linear-gradient(135deg, #2fd07a, #22a862); }
.btn.warn { background: linear-gradient(135deg, #ffb020, #e08b00); }
.btn.bad { background: linear-gradient(135deg, #ff5c72, #e03a52); }
.btn.sm { height: 72rpx; font-size: 28rpx; border-radius: 18rpx; }
.btn[disabled] { opacity: .45; }

/* 数据块 */
.kpi { background: #1e2a38; border-radius: 20rpx; padding: 20rpx 22rpx; }
.kpi .num { font-size: 40rpx; font-weight: 700; line-height: 1.2; }
.kpi .label { font-size: 22rpx; color: #8fa3b7; }

/* 细分割线列表行 */
.line {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 0; border-bottom: 1rpx dashed #2b3949;
}
.line:last-child { border-bottom: none; }

/* 进度条 */
.progress { height: 10rpx; background: #2b3949; border-radius: 99rpx; overflow: hidden; }
.progress-inner { height: 100%; background: linear-gradient(90deg, #3ea6ff, #7c5cff); width: 0; }

/* ===== 宽屏适配：iPad / 折叠屏展开 / 双屏 Duo / PC 窗口 =====
   .wide 由 utils/layout.js 在窗口短边 >= 600px 时挂到页面根节点（<view class="page">）。
   为什么需要：rpx 的换算是"750rpx = 屏幕宽度"，宽屏上 30rpx 会被放大到 1.5~2 倍，
   卡片撑满整屏、按钮巨大、一行放不下原来的内容。这里把关键尺寸改回 px，
   视觉比例回到手机上的样子；内容区宽度由根节点的 max-width(px) 限制并居中。 */

/* 大屏基础字号：app.wxss 的 30rpx 在 iPad 上会被放大到 ~40px，收回成 16px */
.page.wide { font-size: 16px; padding-left: 24px; padding-right: 24px; }

.wide .card { padding: 20px; border-radius: 14px; margin-bottom: 16px; }
.wide .card-title { font-size: 17px; }
.wide .t1 { font-size: 19px; }
.wide .t2, .wide .muted { font-size: 14px; }
.wide .btn { height: 46px; border-radius: 12px; font-size: 17px; }
.wide .btn.sm { height: 36px; font-size: 15px; border-radius: 10px; }
.wide .kpi { padding: 14px 16px; border-radius: 12px; }
.wide .kpi .num { font-size: 26px; }
.wide .kpi .label { font-size: 13px; }
.wide .line { padding: 12px 0; }
.wide .grid-2, .wide .grid-3 { gap: 16px; }
.wide .input { height: 44px; font-size: 16px; }

/* 首页 hero（页面 wxss 里是 rpx，宽屏会被放大；这里按 px 收回） */
.wide .hero-label { font-size: 14px; }
.wide .hero-num { font-size: 46px; }
.wide .hero-unit { font-size: 17px; }
.wide .book-chips { margin-top: 12px; gap: 7px 8px; }
.wide .book-chip { padding: 6px 12px; font-size: 14px; }

/* 学习页/抽查页/班级页的关键元素 */
.wide .assign-bar { padding: 10px 14px; }
.wide .assign-name, .wide .assign-num { font-size: 14px; }
.wide .qopt { padding: 14px 16px; font-size: 16px; border-radius: 12px; }
.wide .assign { padding: 14px; border-radius: 12px; }

/* 拼写键盘：大屏上按键不该跟着放大成麻将牌 */
.wide .kb-key { height: 44px; border-radius: 10px; font-size: 18px; }
.wide .kb-bar { height: 40px; }
.wide .kb-del, .wide .kb-clear { height: 40px; font-size: 15px; }
