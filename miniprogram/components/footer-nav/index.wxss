.nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  /* 原来写的是 rgba(20,28,38,.97)：浅色皮肤下底栏是块深色的，看着像没换肤成功。
     底栏要跟着 themes 走，但又要能透出下面的内容，所以取 panel（夜色下与旧值肉眼无差）。 */
  background: var(--panel);
  border-top: 1rpx solid var(--line);
  padding-bottom: env(safe-area-inset-bottom);
}
.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 0 10rpx;
  color: var(--muted);
}
.nav-item.on { color: var(--accent); }
.nav-ico { font-size: 34rpx; line-height: 1.1; }
.nav-label { font-size: 22rpx; margin-top: 4rpx; }

/* 占位，避免内容被固定导航遮住 */
.nav-placeholder { height: 130rpx; }

/* 糖果拟物：底栏从贴边长条变成悬浮软糖胶囊（皮肤类由组件 js 自己算，见 index.js） */
.nav.skin-candy {
  left: 20rpx;
  right: 20rpx;
  bottom: 16rpx;
  border-top: none;
  border-radius: 44rpx;
  box-shadow:
    0 16rpx 36rpx rgba(203, 92, 130, .35),
    inset 0 3rpx 8rpx rgba(255, 255, 255, .9);
}
