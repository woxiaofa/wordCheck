.nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  background: rgba(20, 28, 38, .97);
  border-top: 1rpx solid #2b3949;
  padding-bottom: env(safe-area-inset-bottom);
}
.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 0 10rpx;
  color: #8fa3b7;
}
.nav-item.on { color: #3ea6ff; }
.nav-ico { font-size: 34rpx; line-height: 1.1; }
.nav-label { font-size: 22rpx; margin-top: 4rpx; }

/* 占位，避免内容被固定导航遮住 */
.nav-placeholder { height: 130rpx; }
