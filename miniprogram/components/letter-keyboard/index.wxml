<!-- 自绘字母键盘
     为什么必须自研：系统输入法会联想、纠错、自动首字母大写，
     用它来做拼写题等于把题目难度交给输入法 —— 用户打出前三个字母就被补全了。

     布局（v6，2026-10-10）：全键盘，键位与电脑 QWERTY 完全一致 ——
     小孩普遍接触电脑，QWERTY 已有肌肉记忆，跟电脑一致 = 零学习成本。
     第三行左端 ⇧ 大小写键（真键盘同位），word 含大写字母时自动亮起（如 Mr）；
     第四行是连字符 + 空格长条（新版教材词表收录短语：to-do list / ice cream）。
     退格在第三行末尾（电脑键盘位置）；◀ ▶ / 清空 / 确定在下方操作行。
     整体贴底弹出式：去左右边距、键加高 —— 用户反馈旧卡片边框吃宽度、键太小。 -->
<view class="kb">
  <!-- 大写态整块换成 rowsUpper：键上的字由 JS 备好两份数据，
       WXML 不做大小写转换（wxs 里没有 String 构造函数，转失败就整排键空白 —— 2026-10-11 实锤） -->
  <view class="kb-row {{ri === 1 ? 'kb-row2' : (ri === 2 ? 'kb-row3' : '')}}"
        wx:for="{{shift ? rowsUpper : rows}}" wx:for-item="row" wx:for-index="ri" wx:key="*this">
    <view wx:if="{{ri === 2}}" class="kb-key kb-shift {{shift ? 'kb-shift-on' : ''}}"
          data-action="shift" bindtap="onAction">⇧</view>
    <view
      class="kb-key"
      wx:for="{{row}}"
      wx:for-item="k"
      wx:key="*this"
      data-letter="{{k}}"
      bindtap="onLetter"
    >{{k}}</view>
    <view wx:if="{{ri === 2}}" class="kb-key kb-del" data-action="del" bindtap="onAction">⌫</view>
  </view>

  <view class="kb-row kb-row4">
    <view
      wx:for="{{extraRow}}"
      wx:for-item="k"
      wx:key="id"
      class="kb-key {{k.id === 'space' ? 'kb-space' : 'kb-hyphen'}}"
      data-char="{{k.id}}"
      bindtap="onChar"
    >{{k.label}}</view>
  </view>

  <view class="kb-bar">
    <view class="kb-nav {{caret <= 0 ? 'kb-nav-off' : ''}}" data-action="left" bindtap="onAction">◀</view>
    <view class="kb-nav {{caret >= value.length ? 'kb-nav-off' : ''}}" data-action="right" bindtap="onAction">▶</view>
    <view wx:if="{{showClear}}" class="kb-clear" data-action="clear" bindtap="onAction">清空</view>
    <view class="kb-go" data-action="confirm" bindtap="onAction">{{confirmLabel}}</view>
  </view>
</view>
