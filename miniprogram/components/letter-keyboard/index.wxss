.kb {
  background: #1a2432;
  border: 1rpx solid #2b3949;
  border-radius: 20rpx;
  padding: 12rpx;
}
.kb-row {
  display: flex;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.kb-row:last-child { margin-bottom: 0; }

.kb-key {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #243040;
  border: 1rpx solid #2b3949;
  border-radius: 12rpx;
  color: #e8eef5;
  font-size: 30rpx;
  font-weight: 600;
}
.kb-key:active {
  background: #3ea6ff;
  color: #ffffff;
}
.kb-key.action {
  font-size: 24rpx;
  font-weight: 500;
  color: #cfe0f0;
}
.kb-key.action.del { background: #2b3949; }
.kb-key.action.clear { background: #2b3949; }
.kb-key.action.go {
  background: linear-gradient(135deg, #3ea6ff, #7c5cff);
  color: #ffffff;
  font-weight: 600;
}
