# 依赖与构建产物
node_modules/
miniprogram_npm/

# 微信开发者工具的本地配置（含个人设置，不应进仓库）
project.private.config.json
.idea/
.vscode/

# 云函数依赖
cloud/functions/*/node_modules/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 开源字体文件（17MB，按需下载，见 assets/fonts/README.md）
assets/fonts/*.otf
assets/fonts/*.ttf
assets/fonts/*.ttc

# 云函数目录里的 shared 副本（由 scripts/prepare-functions.js 生成，部署前自动就位）
cloud/functions/*/shared/

# Piper 语音模型（63MB，按需下载，见 scripts/gen_audio_piper.py 注释里的 hf-mirror 链接）
scripts/piper-models/

# 词表导出（由 words.js 生成，是生成音频的中间产物）
scripts/words.json
