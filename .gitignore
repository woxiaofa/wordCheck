# 依赖与构建产物
node_modules/
miniprogram_npm/

# 微信开发者工具的本地配置（含个人设置，不应进仓库）
project.private.config.json
.idea/
.vscode/

# 云函数依赖
cloud/functions/*/node_modules/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 开源字体文件（17MB，按需下载，见 assets/fonts/README.md）
assets/fonts/*.otf
assets/fonts/*.ttf
assets/fonts/*.ttc

# 注意：cloud/functions/*/shared/ 这几个副本【必须】随仓库跟踪、随部署上传——
# 开发者工具/CLI 上传时会忽略 .gitignore 命中的文件，曾导致云端
# "Cannot find module ./shared/time"（2026-10-05 实锤）。勿再把它们加回来。

# Piper 语音模型（63MB，按需下载，见 scripts/gen_audio_piper.py 注释里的 hf-mirror 链接）
scripts/piper-models/

# 词表导出（由 words.js 生成，是生成音频的中间产物）
scripts/words.json
