# 依赖与构建产物
node_modules/
miniprogram_npm/

# 微信开发者工具的本地配置（含个人设置，不应进仓库）
project.private.config.json
.idea/
.vscode/

# 云函数依赖
cloud/functions/*/node_modules/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 开源字体文件（17MB，按需下载，见 assets/fonts/README.md）
assets/fonts/*.otf
assets/fonts/*.ttf
assets/fonts/*.ttc

# 注意：云函数目录里的共享模块副本（quiz/srs/state-store/time.js，平铺在函数根目录）
# 【必须】随仓库跟踪、随部署上传——曾经 shared/ 子目录方案在 CLI 部署后
# 云端报 Cannot find module（2026-10-05/06 实锤），已改平铺并由
# scripts/prepare-functions.js 生成。勿再改回子目录结构。

# Piper 语音模型（63MB，按需下载，见 scripts/gen_audio_piper.py 注释里的 hf-mirror 链接）
scripts/piper-models/

# 词表导出（由 words.js 生成，是生成音频的中间产物）
scripts/words.json

# 开发者工具生成的预览二维码（临时产物）
.preview/

# WorkBuddy 会话/记忆/LS 索引（本机工程数据，不进仓库）
.workbuddy/

# 短视频素材（体积大且可由脚本重新生成，脚本与网页进仓库）
assets/video/*.mp4
assets/video/*.wav
assets/video/audio/

# 待用户确认后再处理的旧测试与夹具（保持未纳管）
tests/fixtures/
tests/seed-then-assign.test.js

# 备案证件等个人材料绝不进仓库（脚本输出到 Documents/备案材料/）
*身份证*
*人像面*
*国徽面*

# 全库导出备份：含真实用户、班级、学习流水，绝不进仓库（2026-11-12 实测导出）
backups/
